    maxoutbuf: '0'
    minoutbuf: '0'
    amp: amp_inf
    freq: -f_tono
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1680
    rotation: 0
    state: enabled
