- name: receta
  id: snippet
  parameters:
    alias: ''
    comment: 'Secuencia del peine: esperar, calibrar o

      transmitir'
    priority: '0'
    section: main_after_init
    code: "# ============================================================================\n\
      # RECETA DEL PEINE AUTOMATICO\n# Este codigo corre al mismo tiempo que el flujo.\
      \ Hace lo que se elija en\n# \"Orden\" en la ventana: esperar, calibrar o transmitir.\n\
      # Usa solo las variables del flujo: las lee con self.get_...() y las cambia\n\
      # con self.set_...(). Generar los tonos, medir y mostrar lo hacen los bloques.\n\
      # ============================================================================\n\
      import time\nimport threading\n\nESPERA_SILENCIO = 0.3      # segundos con los\
      \ tonos apagados antes de cada salto\nESPERA_LECTURA = 1.0       # segundos\
      \ de espera antes de leer el receptor\n\n\ndef saltar_a(i):\n    # Apaga los\
      \ tonos, pasa a la portadora numero i y los vuelve a encender.\n    # Asi no\
      \ sale ningun tono mientras la placa cambia de frecuencia.\n    self.set_silencio(1)\n\
      \    time.sleep(ESPERA_SILENCIO)\n    self.set_indice(i)\n    self.set_silencio(0)\n\
      \n\ndef medir_todas_las_lineas():\n    # Recorre las portadoras y anota el nivel\
      \ de cada linea leido por el RX.\n    # A cada lectura le resta lo que el propio\
      \ RX lee de mas en esa linea.\n    respuesta = self.get_respuesta_rx()\n   \
      \ niveles = []\n    for i in range(self.get_n_port()):\n        saltar_a(i)\n\
      \        time.sleep(ESPERA_LECTURA)\n        niveles.append(self.get_nivel_inf()\
      \ - respuesta[2 * i])\n        niveles.append(self.get_nivel_sup() - respuesta[2\
      \ * i + 1])\n    return niveles\n\n\ndef calibrar():\n    cantidad = 2 * self.get_n_port()\
      \             # cantidad de lineas\n    correcciones = [0.0] * cantidad    \
      \          # se empieza sin corregir nada\n    self.set_correcciones(correcciones)\n\
      \n    self.set_etapa('CALIBRACION, vuelta 1 de 3: midiendo sin corregir')\n\
      \    niveles = medir_todas_las_lineas()\n    if min(niveles) < -75 or max(niveles)\
      \ > -10:\n        self.set_resultado('CANCELADA: niveles fuera de rango (revisar\
      \ el cable y las ganancias)')\n        return\n    objetivo = min(niveles) \
      \                     # todas las lineas bajan hasta la mas debil\n    planitud_antes\
      \ = max(niveles) - min(niveles)\n    self.set_desvio_antes([n - objetivo for\
      \ n in niveles])\n\n    for vuelta in [2, 3]:\n        nuevas = []\n       \
      \ for k in range(cantidad):\n            c = correcciones[k] + (objetivo - niveles[k])\n\
      \            if c > 0:\n                c = 0.0                          # una\
      \ linea no puede subir mas que el maximo\n            nuevas.append(c)\n   \
      \     correcciones = nuevas\n        self.set_correcciones(correcciones)\n \
      \       self.set_etapa('CALIBRACION, vuelta %d de 3: midiendo con la correccion'\
      \ % vuelta)\n        niveles = medir_todas_las_lineas()\n\n    self.set_desvio_despues([n\
      \ - objetivo for n in niveles])\n    planitud_despues = max(niveles) - min(niveles)\n\
      \    self.set_resultado('antes %.1f dB, despues %.1f dB' % (planitud_antes,\
      \ planitud_despues))\n\n\ndef transmitir_una_pasada():\n    for i in range(self.get_n_port()):\n\
      \        if self.get_orden() != 2:\n            return                     \
      \          # cambio la orden: se corta la pasada\n        saltar_a(i)\n    \
      \    time.sleep(self.get_permanencia())\n    self.set_pasadas(self.get_pasadas()\
      \ + 1)\n\n\ndef receta():\n    time.sleep(2)                               \
      \ # deja que el flujo termine de arrancar\n    while True:\n        if self.get_orden()\
      \ == 1:\n            calibrar()\n            self.set_orden(0)             \
      \       # al terminar vuelve a esperar\n        elif self.get_orden() == 2:\n\
      \            self.set_etapa('TRANSMISION')\n            transmitir_una_pasada()\n\
      \        else:\n            self.set_etapa('EN ESPERA (sin emitir)')\n     \
      \       self.set_silencio(1)\n            time.sleep(0.2)\n\n\nthreading.Thread(target=receta,\
      \ daemon=True).start()\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 3060
    rotation: 0
    state: enabled
