options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'bladeRF 2.0 micro xA9: peine de 70 a 420 MHz, lineas cada 10 MHz.
      El receptor de la propia placa mide cada linea por cable y el flujo corrige
      la amplitud de cada tono hasta dejarlas iguales. Despues transmite'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: exp19_a9_peine_automatico
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'EXP-19 xA9: peine por tandas con calibracion automatica'
    window_size: (2950,3450)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'Tasa de muestreo, comun a TX y RX. En esta

      PC no pasar de 25e6'
    value: 20e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 16
    rotation: 0
    state: enabled
- name: f_tono
  id: variable
  parameters:
    comment: 'Cada portadora lleva dos tonos: en +f_tono y

      en -f_tono'
    value: 5e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 16
    rotation: 0
    state: enabled
- name: amp
  id: variable
  parameters:
    comment: 'Amplitud de un tono sin corregir. La suma de

      los dos no debe pasar de 0.95'
    value: '0.45'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 16
    rotation: 0
    state: enabled
- name: ancho_banda
  id: variable
  parameters:
    comment: Filtro analogico de la placa, en TX y en RX
    value: 18e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 16
    rotation: 0
    state: enabled
- name: tope
  id: variable
  parameters:
    comment: 'Tope de seguridad de la ganancia de TX con

      el cable al receptor: con 30 dB salen unos

      -27 dBm como maximo'
    value: '30'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 16
    rotation: 0
    state: enabled
- name: f_primera
  id: variable
  parameters:
    comment: 'Primera portadora. Sus lineas salen en 70 y

      80 MHz'
    value: 75e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 200
    rotation: 0
    state: enabled
- name: paso_port
  id: variable
  parameters:
    comment: Separacion entre portadoras
    value: 20e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 200
    rotation: 0
    state: enabled
- name: n_port
  id: variable
  parameters:
    comment: 'Cantidad de portadoras: 18 dan 36 lineas, de

      70 a 420 MHz'
    value: '18'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 200
    rotation: 0
    state: enabled
- name: respuesta_rx
  id: variable
  parameters:
    comment: 'Cuantos dB de mas lee el RX en cada linea

      (70, 80, ... 420 MHz). Queda en cero hasta

      compararlo con un analizador'
    value: '[0.0] * 36'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 200
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: El filtro de cada tono baja la tasa a 1 MSPS
    value: int(samp_rate / 1e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 400
    rotation: 0
    state: enabled
- name: taps
  id: variable_low_pass_filter_taps
  parameters:
    comment: Pasabajos que deja solo el tono elegido
    gain: '1.0'
    samp_rate: samp_rate
    cutoff_freq: 100e3
    width: 400e3
    win: window.WIN_HAMMING
    beta: '6.76'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 400
    rotation: 0
    state: enabled
- name: largo_promedio
  id: variable
  parameters:
    comment: 'Muestras que se promedian: 0,1 s a 1 MSPS'
    value: '100000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 736
    - 400
    rotation: 0
    state: enabled
- name: nivel_inf
  id: variable_function_probe
  parameters:
    block_id: sonda_inf
    comment: 'Nivel del tono inferior leido por el RX, en

      dB'
    function_args: ''
    function_name: level
    poll_rate: '10'
    value: '-120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1066
    - 400
    rotation: 0
    state: enabled
- name: nivel_sup
  id: variable_function_probe
  parameters:
    block_id: sonda_sup
    comment: 'Nivel del tono superior leido por el RX, en

      dB'
    function_args: ''
    function_name: level
    poll_rate: '10'
    value: '-120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1396
    - 400
    rotation: 0
    state: enabled
- name: indice
  id: variable
  parameters:
    comment: 'Portadora actual, de 0 a n_port - 1. La

      cambia la receta'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 620
    rotation: 0
    state: enabled
- name: silencio
  id: variable
  parameters:
    comment: '1: tonos apagados. 0: tonos encendidos. Lo

      cambia la receta'
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 620
    rotation: 0
    state: enabled
- name: correcciones
  id: variable
  parameters:
    comment: 'Correccion de cada linea, en dB (0 o

      negativa). Las calcula la receta'
    value: '[0.0] * 36'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 620
    rotation: 0
    state: enabled
- name: etapa
  id: variable
  parameters:
    comment: 'Texto de la etapa actual. Lo cambia la

      receta'
    value: '''INICIACION'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 620
    rotation: 0
    state: enabled
- name: pasadas
  id: variable
  parameters:
    comment: Pasadas completas del peine en transmision
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 620
    rotation: 0
    state: enabled
- name: desvio_antes
  id: variable
  parameters:
    comment: 'Cuanto sobresalia cada linea antes de

      corregir, en dB'
    value: '[0.0] * 36'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 620
    rotation: 0
    state: enabled
- name: desvio_despues
  id: variable
  parameters:
    comment: 'Cuanto se aparta cada linea despues de

      corregir, en dB'
    value: '[0.0] * 36'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1996
    - 620
    rotation: 0
    state: enabled
- name: resultado
  id: variable
  parameters:
    comment: Resumen de la ultima calibracion
    value: '''todavia sin calibrar'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2326
    - 620
    rotation: 0
    state: enabled
- name: orden
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,0,1,4
    label: Orden
    labels: '[''Esperar (sin emitir)'', ''Calibrar (cable de TX1 a RX1)'', ''Transmitir
      el peine'']'
    options: '[0, 1, 2]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '0'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 820
    rotation: 0
    state: enabled
- name: ganancia_base
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,4,1,3
    label: Ganancia de TX
    labels: '[''0 dB'', ''10 dB'', ''20 dB'', ''30 dB'']'
    options: '[0, 10, 20, 30]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '30'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 820
    rotation: 0
    state: enabled
- name: permanencia
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,7,1,3
    label: Permanencia por portadora
    labels: '[''0,5 s'', ''1 s'', ''2 s'', ''3 s'', ''5 s'']'
    options: '[0.5, 1, 2, 3, 5]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: real
    value: '1'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 820
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,10,1,2
    label: Ganancia de RX
    labels: '[''0 dB'', ''10 dB'', ''20 dB'', ''30 dB'', ''40 dB'', ''50 dB'', ''60
      dB'']'
    options: '[0, 10, 20, 30, 40, 50, 60]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '0'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 820
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: 'Frecuencia de la portadora actual, en TX y

      en RX'
    value: f_primera + paso_port * indice
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1080
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: 'Ganancia que recibe la placa: nunca supera

      el tope'
    value: min(ganancia_base, tope)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 406
    - 1080
    rotation: 0
    state: enabled
- name: c_inf
  id: variable
  parameters:
    comment: 'Correccion de la linea inferior actual, en

      dB'
    value: correcciones[2 * indice]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 736
    - 1080
    rotation: 0
    state: enabled
- name: c_sup
  id: variable
  parameters:
    comment: 'Correccion de la linea superior actual, en

      dB'
    value: correcciones[2 * indice + 1]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1066
    - 1080
    rotation: 0
    state: enabled
- name: amp_inf
  id: variable
  parameters:
    comment: Amplitud del tono inferior ya corregida
    value: 0 if silencio == 1 else amp * 10 ** (c_inf / 20)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1436
    - 1080
    rotation: 0
    state: enabled
- name: amp_sup
  id: variable
  parameters:
    comment: Amplitud del tono superior ya corregida
    value: 0 if silencio == 1 else amp * 10 ** (c_sup / 20)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1886
    - 1080
    rotation: 0
    state: enabled
- name: et_etapa
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:16pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,0,1,12
    label: '<span style=''font-size:16pt''>Etapa: </span>'
    type: string
    value: etapa
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1280
    rotation: 0
    state: enabled
- name: et_portadora
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:13pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 2,0,1,4
    label: '<span style=''font-size:13pt''>Portadora: </span>'
    type: string
    value: '''%d de %d, en %.0f MHz'' % (indice + 1, n_port, freq / 1e6)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 1280
    rotation: 0
    state: enabled
- name: et_lineas
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:13pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 2,4,1,4
    label: '<span style=''font-size:13pt''>Lineas: </span>'
    type: string
    value: '''%.0f y %.0f MHz'' % ((freq - f_tono) / 1e6, (freq + f_tono) / 1e6)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 1280
    rotation: 0
    state: enabled
- name: et_pasadas
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:13pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 2,8,1,4
    label: '<span style=''font-size:13pt''>Pasadas completas: </span>'
    type: int
    value: pasadas
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 1280
    rotation: 0
    state: enabled
- name: et_amp
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 3,0,1,4
    label: '<span style=''font-size:11pt''>Amplitudes: </span>'
    type: string
    value: '''%.3f y %.3f'' % (amp_inf, amp_sup)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 1280
    rotation: 0
    state: enabled
- name: et_rx
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 3,4,1,4
    label: '<span style=''font-size:11pt''>El RX lee ahora: </span>'
    type: string
    value: '''%.1f y %.1f dB'' % (nivel_inf, nivel_sup)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 1280
    rotation: 0
    state: enabled
- name: et_resultado
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 3,8,1,4
    label: '<span style=''font-size:11pt''>Planitud segun el RX: </span>'
    type: string
    value: resultado
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1996
    - 1280
    rotation: 0
    state: enabled
- name: et_tabla
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 5,0,1,12
    label: 'Correcciones en dB, de 70 a 420 MHz: '
    type: string
    value: ''', ''.join([''%.1f'' % c for c in correcciones])'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2326
    - 1280
    rotation: 0
    state: enabled
- name: tono_superior
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: Sale en portadora + 5 MHz
    maxoutbuf: '0'
