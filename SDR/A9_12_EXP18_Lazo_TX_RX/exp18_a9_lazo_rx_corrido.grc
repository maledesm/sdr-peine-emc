options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'bladeRF 2.0 micro xA9: transmite dos tonos en +/-5 MHz y los mide
      con su propio receptor por cable. Version 2: el receptor se sintoniza 1 MHz
      por encima del transmisor, para que cada tono caiga en una frecuencia propia
      y la lectura no dependa de la fase entre los dos osciladores. Sin codigo Python'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: exp18_a9_lazo_rx_corrido
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'EXP-18 v2 xA9: lazo TX1 a RX1 con el receptor corrido'
    window_size: (2400,2200)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'Tasa de muestreo, comun a TX y RX. En esta

      PC no pasar de 25e6'
    value: 20e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 16
    rotation: 0
    state: enabled
- name: f_tono
  id: variable
  parameters:
    comment: 'Dos tonos: en +f_tono y en -f_tono'
    value: 5e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 16
    rotation: 0
    state: enabled
- name: ancho_banda
  id: variable
  parameters:
    comment: Filtro analogico de la placa, en TX y en RX
    value: 18e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 16
    rotation: 0
    state: enabled
- name: tope
  id: variable
  parameters:
    comment: 'Tope de seguridad de la ganancia de TX con

      el cable al receptor: con 30 dB salen unos

      -27 dBm como maximo'
    value: '30'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 16
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1726
    - 16
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: El filtro de cada tono baja la tasa a 1 MSPS
    value: int(samp_rate / 1e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 200
    rotation: 0
    state: enabled
- name: taps
  id: variable_low_pass_filter_taps
  parameters:
    comment: Pasabajos que deja solo el tono elegido
    gain: '1.0'
    samp_rate: samp_rate
    cutoff_freq: 100e3
    width: 400e3
    win: window.WIN_HAMMING
    beta: '6.76'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 200
    rotation: 0
    state: enabled
- name: largo_promedio
  id: variable
  parameters:
    comment: 'Muestras que se promedian: 0,1 s a 1 MSPS'
    value: '100000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 736
    - 200
    rotation: 0
    state: enabled
- name: nivel_inf
  id: variable_function_probe
  parameters:
    block_id: sonda_inf
    comment: 'Nivel del tono inferior leido por el RX, en

      dB'
    function_args: ''
    function_name: level
    poll_rate: '5'
    value: '-120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1066
    - 200
    rotation: 0
    state: enabled
- name: nivel_sup
  id: variable_function_probe
  parameters:
    block_id: sonda_sup
    comment: 'Nivel del tono superior leido por el RX, en

      dB'
    function_args: ''
    function_name: level
    poll_rate: '5'
    value: '-120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1396
    - 200
    rotation: 0
    state: enabled
- name: portadora
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,0,1,2
    label: Portadora
    labels: '[''75 MHz'', ''135 MHz'', ''195 MHz'', ''255 MHz'', ''315 MHz'', ''335
      MHz'', ''415 MHz'']'
    options: '[75, 135, 195, 255, 315, 335, 415]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '75'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 420
    rotation: 0
    state: enabled
- name: ganancia_tx
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,2,1,2
    label: Ganancia de TX
    labels: '[''0 dB'', ''10 dB'', ''20 dB'', ''30 dB'']'
    options: '[0, 10, 20, 30]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '0'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 420
    rotation: 0
    state: enabled
- name: amp
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,4,1,2
    label: Amplitud de cada tono
    labels: '[''0.05'', ''0.1'', ''0.2'', ''0.45'']'
    options: '[0.05, 0.1, 0.2, 0.45]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: real
    value: '0.45'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 420
    rotation: 0
    state: enabled
- name: hab_inf
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    gui_hint: 2,0,1,1
    label: Tono inferior
    type: int
    'true': '1'
    'false': '0'
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 420
    rotation: 0
    state: enabled
- name: hab_sup
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    gui_hint: 2,1,1,1
    label: Tono superior
    type: int
    'true': '1'
    'false': '0'
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 420
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 2,2,1,2
    label: Ganancia de RX
    labels: '[''0 dB'', ''10 dB'', ''20 dB'', ''30 dB'', ''40 dB'', ''50 dB'', ''60
      dB'']'
    options: '[0, 10, 20, 30, 40, 50, 60]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '10'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 420
    rotation: 0
    state: enabled
- name: corrimiento
  id: variable_qtgui_chooser
  parameters:
    comment: 'Cuanto mas arriba que el transmisor se

      sintoniza el receptor'
    gui_hint: 2,4,1,2
    label: Corrimiento del RX
    labels: '[''0 (igual que el TX)'', ''1 MHz'', ''2 MHz'']'
    options: '[0, 1, 2]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '1'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1996
    - 420
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: Frecuencia del transmisor, en Hz
    value: portadora * 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 680
    rotation: 0
    state: enabled
- name: freq_rx
  id: variable
  parameters:
    comment: 'Frecuencia del receptor: la del transmisor

      mas el corrimiento'
    value: freq + corrimiento * 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 680
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: 'Ganancia que recibe la placa: nunca supera

      el tope'
    value: min(ganancia_tx, tope)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 736
    - 680
    rotation: 0
    state: enabled
- name: nivel_estimado
  id: variable
  parameters:
    comment: 'dBm por tono, segun el EXP-17: -33 dBm con

      ganancia 30 y amplitud 0.45'
    value: tx_gain - 56 + 20 * math.log10(amp)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1126
    - 680
    rotation: 0
    state: enabled
- name: nivel_mayor
  id: variable
  parameters:
    comment: El mas alto de los dos tonos recibidos
    value: max(nivel_inf, nivel_sup)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 680
    rotation: 0
    state: enabled
- name: estado
  id: variable
  parameters:
    comment: 'Zona de trabajo del receptor: entre -30 y

      -12 dB'
    value: '''SIN SENAL'' if nivel_mayor < -75 else (''BAJO: se puede subir la ganancia
      de RX'' if nivel_mayor < -30 else (''BIEN'' if nivel_mayor < -12 else ''ALTO:
      bajar la ganancia de RX''))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1996
    - 680
    rotation: 0
    state: enabled
- name: et_tx
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:13pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,0,1,6
    label: '<span style=''font-size:13pt''>Transmite: </span>'
    type: string
    value: '''%.0f y %.0f MHz, ganancia %d dB, unos %.0f dBm por tono. Recibe centrado
      en %.0f MHz'' % ((freq - f_tono) / 1e6, (freq + f_tono) / 1e6, tx_gain, nivel_estimado,
      freq_rx / 1e6)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 880
    rotation: 0
    state: enabled
- name: et_estado
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:13pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 4,0,1,6
    label: '<span style=''font-size:13pt''>Receptor: </span>'
    type: string
    value: estado
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 880
    rotation: 0
    state: enabled
- name: et_inf
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>%.1f dB</b></span>" %
      x'
    gui_hint: 3,0,1,2
    label: '<span style=''font-size:15pt''>RX inferior: </span>'
    type: real
    value: nivel_inf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 880
    rotation: 0
    state: enabled
- name: et_sup
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>%.1f dB</b></span>" %
      x'
    gui_hint: 3,2,1,2
    label: '<span style=''font-size:15pt''>RX superior: </span>'
    type: real
    value: nivel_sup
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 880
    rotation: 0
    state: enabled
- name: et_dif
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>%+.1f dB</b></span>"
      % x'
    gui_hint: 3,4,1,2
    label: '<span style=''font-size:15pt''>Superior - inferior: </span>'
    type: real
    value: nivel_sup - nivel_inf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 880
    rotation: 0
    state: enabled
- name: tono_superior
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: Sale en portadora + 5 MHz
    maxoutbuf: '0'
    minoutbuf: '0'
    amp: amp * hab_sup
    freq: f_tono
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1080
    rotation: 0
    state: enabled
- name: tono_inferior
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: Sale en portadora - 5 MHz
    maxoutbuf: '0'
    minoutbuf: '0'
    amp: amp * hab_inf
    freq: -f_tono
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1280
    rotation: 0
    state: enabled
