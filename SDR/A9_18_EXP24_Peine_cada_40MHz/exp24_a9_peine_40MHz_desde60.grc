- name: archivos_de_calibracion
  id: snippet
  parameters:
    alias: ''
    comment: 'Genera la calibracion desde una captura, la

      guarda en un archivo y la vuelve a cargar'
    priority: '0'
    section: main_after_init
    code: "# ============================================================================\n\
      # ARCHIVOS DE CALIBRACION\n# Es el unico codigo Python del flujo. Hace falta\
      \ porque los bloques no saben\n# escribir ni leer archivos.\n#   Boton \"Generar\
      \ calibracion\": pide la captura (.csv) que guardo el analizador\n#   con el\
      \ peine SIN calibrar, busca el pico de cada linea, lo carga en su\n#   contador\
      \ y guarda el archivo de calibracion.\n#   Boton \"Guardar calibracion\": escribe\
      \ en un archivo de texto los 24 valores\n#   cargados en la ventana, uno por\
      \ renglon, junto a su frecuencia.\n#   Boton \"Importar calibracion previa\"\
      : lee ese archivo y pone cada valor en\n#   su contador.\n# ============================================================================\n\
      import os\nimport time\n\nPRIMERA_LINEA = 60        # MHz\nSEPARACION = 40 \
      \          # MHz entre una linea y la siguiente\nCERCA = 4                 #\
      \ MHz: hasta que distancia de una linea se busca su pico\n\n# Los 24 contadores\
      \ de la ventana, en orden de frecuencia (60, 100, ... 980 MHz).\n# d_widget\
      \ es la casilla con flechas que se ve en pantalla.\ncontadores = [\n    self._m_60_win.d_widget,\
      \ self._m_100_win.d_widget, self._m_140_win.d_widget,\n    self._m_180_win.d_widget,\
      \ self._m_220_win.d_widget, self._m_260_win.d_widget,\n    self._m_300_win.d_widget,\
      \ self._m_340_win.d_widget, self._m_380_win.d_widget,\n    self._m_420_win.d_widget,\
      \ self._m_460_win.d_widget, self._m_500_win.d_widget,\n    self._m_540_win.d_widget,\
      \ self._m_580_win.d_widget, self._m_620_win.d_widget,\n    self._m_660_win.d_widget,\
      \ self._m_700_win.d_widget, self._m_740_win.d_widget,\n    self._m_780_win.d_widget,\
      \ self._m_820_win.d_widget, self._m_860_win.d_widget,\n    self._m_900_win.d_widget,\
      \ self._m_940_win.d_widget, self._m_980_win.d_widget,\n]\n\n\ndef guardar():\n\
      \    valores = self.get_medidos()                 # los 24 valores de la ventana\n\
      \    try:\n        archivo = open(self.get_archivo(), 'w')\n        # primer\
      \ renglon: cuando se guardo y con que ganancia se leyeron los valores\n    \
      \    archivo.write('# guardada el ' + time.strftime('%d-%m-%Y %H:%M') +\n  \
      \                    ', valores leidos con ganancia %d dB\\n' % self.get_ganancia_de_lectura())\n\
      \        for k in range(len(valores)):\n            frecuencia = PRIMERA_LINEA\
      \ + SEPARACION * k\n            archivo.write('%d %.1f\\n' % (frecuencia, valores[k]))\n\
      \        archivo.close()\n    except Exception:\n        self.set_estado_archivo('NO\
      \ se pudo guardar')\n        return False\n    self.set_estado_archivo('guardada\
      \ a las ' + time.strftime('%H:%M:%S'))\n    return True\n\n\ndef importar():\n\
      \    if not os.path.exists(self.get_archivo()):\n        self.set_estado_archivo('no\
      \ hay ninguna calibracion guardada')\n        return\n    try:\n        archivo\
      \ = open(self.get_archivo())\n        renglones = archivo.readlines()\n    \
      \    archivo.close()\n        if renglones[0].startswith('#'):\n           \
      \ renglones = renglones[1:]            # se saltea el renglon de encabezado\n\
      \        valores = []\n        for k in range(len(contadores)):\n          \
      \  partes = renglones[k].split()        # cada renglon: frecuencia y valor\n\
      \            valores.append(float(partes[1]))\n    except Exception:\n     \
      \   self.set_estado_archivo('el archivo no se pudo leer: no se importo nada')\n\
      \        return\n    for k in range(len(contadores)):\n        contadores[k].setValue(valores[k])\
      \       # al cambiar el contador, el flujo se actualiza solo\n    self.set_estado_archivo('importada\
      \ a las ' + time.strftime('%H:%M:%S'))\n\n\ndef leer_captura(nombre):\n    #\
      \ Lee una captura del analizador: un renglon por punto, con la frecuencia y\n\
      \    # el nivel separados por una coma. Devuelve dos listas: MHz y dBm.\n  \
      \  frecuencias = []\n    niveles = []\n    archivo = open(nombre)\n    for renglon\
      \ in archivo:\n        partes = renglon.replace(';', ',').split(',')\n     \
      \   try:\n            frecuencia = float(partes[0])\n            nivel = float(partes[1])\n\
      \        except Exception:\n            continue                           \
      \  # renglon de titulo o vacio: se saltea\n        if frecuencia > 100000:\n\
      \            frecuencia = frecuencia / 1e6        # estaba en Hz: se pasa a\
      \ MHz\n        frecuencias.append(frecuencia)\n        niveles.append(nivel)\n\
      \    archivo.close()\n    return frecuencias, niveles\n\n\ndef pico_de_la_linea(frecuencias,\
      \ niveles, linea):\n    # Devuelve el nivel mas alto que hay en la captura a\
      \ menos de 4 MHz de la\n    # linea. El pico casi nunca cae justo en la frecuencia\
      \ de la linea, por eso\n    # se busca cerca. Las lineas vecinas estan a 40\
      \ MHz: quedan afuera.\n    # Si la captura no llega hasta esa frecuencia, devuelve\
      \ None.\n    if linea < min(frecuencias) or linea > max(frecuencias):\n    \
      \    return None\n    pico = None\n    for j in range(len(frecuencias)):\n \
      \       if abs(frecuencias[j] - linea) <= CERCA:\n            if pico is None\
      \ or niveles[j] > pico:\n                pico = niveles[j]\n    return pico\n\
      \n\ndef generar():\n    # La captura tiene que ser del peine sin calibrar: con\
      \ los contadores en 0\n    if self.get_cargadas() > 0:\n        self.set_estado_archivo('NO\
      \ se genero: ya hay valores cargados. Cerrar el programa, '\n              \
      \                  'abrirlo de nuevo y capturar el peine sin calibrar')\n  \
      \      return\n\n    # 1) Elegir la captura. Se pueden elegir varias a la vez\n\
      \    elegido = Qt.QFileDialog.getOpenFileNames(self, 'Elegir la captura del\
      \ peine SIN calibrar', '',\n                                              'Capturas\
      \ del analizador (*.csv)')\n    nombres = elegido[0]\n    if len(nombres) ==\
      \ 0:\n        return                                   # se cerro la ventana\
      \ sin elegir nada\n\n    # 2) Leer cada captura\n    capturas = []\n    for\
      \ nombre in nombres:\n        try:\n            frecuencias, niveles = leer_captura(nombre)\n\
      \        except Exception:\n            frecuencias = []\n        if len(frecuencias)\
      \ == 0:\n            self.set_estado_archivo('NO se genero: no se pudo leer\
      \ ' + os.path.basename(nombre))\n            return\n        capturas.append([frecuencias,\
      \ niveles])\n\n    # 3) Buscar el pico de cada linea\n    ganancia = self.get_ganancia()\
      \               # ganancia de TX elegida en la ventana\n    esperado = self.get_nivel_sin_calibrar()\
      \     # nivel aproximado de una linea sin calibrar\n    valores = []       \
      \                          # un valor por linea; None si no hay dato\n    for\
      \ k in range(len(contadores)):\n        linea = PRIMERA_LINEA + SEPARACION *\
      \ k\n        leidos = []\n        for captura in capturas:\n            pico\
      \ = pico_de_la_linea(captura[0], captura[1], linea)\n            if pico is\
      \ not None:\n                leidos.append(pico)\n        if len(leidos) ==\
      \ 0:\n            valores.append(None)                 # ninguna captura llega\
      \ hasta esta linea\n            continue\n        # Con varias capturas se usa\
      \ el valor mas bajo: MAX HOLD a veces retiene\n        # un pico momentaneo,\
      \ y es raro que caiga dos veces en la misma linea\n        valor = min(leidos)\n\
      \        # Control: si el valor esta lejos de lo esperado, la captura no sirve\n\
      \        if valor > esperado + 6 or valor < esperado - 8:\n            self.set_estado_archivo('NO\
      \ se genero: en %d MHz se leyo %.1f dBm y con ganancia %d dB '\n           \
      \                         'se esperaba cerca de %d dBm' % (linea, valor, ganancia,\
      \ esperado))\n            return\n        valores.append(valor)\n\n    # 4)\
      \ Cargar los contadores. El flujo espera valores leidos con la ganancia\n  \
      \  #    de lectura (45 dB): se resta lo que haya de mas en la ganancia usada\n\
      \    diferencia = ganancia - self.get_ganancia_de_lectura()\n    cuantas = 0\n\
      \    for k in range(len(contadores)):\n        if valores[k] is not None:\n\
      \            contadores[k].setValue(round(valores[k] - diferencia, 1))\n   \
      \         cuantas = cuantas + 1\n    if cuantas == 0:\n        self.set_estado_archivo('NO\
      \ se genero: la captura no llega a ninguna linea del peine')\n        return\n\
      \n    # 5) Guardar el archivo de calibracion\n    if guardar():\n        self.set_estado_archivo('generada\
      \ a las %s con %d captura(s): %d lineas, leidas con ganancia %d dB'\n      \
      \                          % (time.strftime('%H:%M:%S'), len(capturas), cuantas,\
      \ ganancia))\n\n\n# GNU Radio llama a set_boton_guardar(1) cuando se aprieta\
      \ el boton y a\n# set_boton_guardar(0) cuando se suelta. Aca se define que hace\
      \ esa llamada.\ndef al_tocar_guardar(valor):\n    if valor == 1:\n        guardar()\n\
      \n\ndef al_tocar_importar(valor):\n    if valor == 1:\n        importar()\n\n\
      \n# Este se hace al soltar el boton: si se hiciera al apretarlo, el boton quedaria\n\
      # hundido mientras esta abierta la ventana para elegir el archivo.\ndef al_tocar_generar(valor):\n\
      \    if valor == 0:\n        generar()\n\n\nself.set_boton_guardar = al_tocar_guardar\n\
      self.set_boton_importar = al_tocar_importar\nself.set_boton_generar = al_tocar_generar\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 3020
    rotation: 0
    state: enabled
connections:
- - tono
