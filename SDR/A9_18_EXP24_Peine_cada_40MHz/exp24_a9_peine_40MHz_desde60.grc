options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'bladeRF 2.0 micro xA9: 24 lineas cada 40 MHz, un tono por portadora,
      con la portadora 10 MHz por encima de la linea y 40 MSPS. Con las lineas desde
      60 MHz, los armonicos del oscilador y la imagen del muestreo caen sobre otras
      lineas del peine; desde 50 MHz caen en el medio. Calibracion desde la captura
      del analizador, siempre a 0 dBm, con opcion de subir todo 3 dB. SOLO para medir
      con el analizador: nunca con el cable en RX1'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: exp24_a9_peine_40MHz_desde60
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'EXP-24 xA9: un tono por portadora, lineas cada 40 MHz desde 60 MHz'
    window_size: (3300,3400)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'Tasa de muestreo. Con 40 MSPS la imagen del

      muestreo cae 40 MHz arriba de la linea, o

      sea sobre la linea siguiente'
    value: 40e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 16
    rotation: 0
    state: enabled
- name: f_tono
  id: variable
  parameters:
    comment: 'El tono va por debajo de la portadora: asi

      la linea de 50 MHz no obliga a sintonizar

      por debajo de 47 MHz'
    value: -separacion * 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 742
    - 16
    rotation: 0
    state: enabled
- name: ancho_banda
  id: variable
  parameters:
    comment: Filtro analogico de la placa
    value: 0.9 * samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1138
    - 16
    rotation: 0
    state: enabled
- name: ganancia_de_lectura
  id: variable
  parameters:
    comment: 'Ganancia de TX a la que estan referidos los

      valores de los contadores y del archivo de

      calibracion'
    value: '45'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1468
    - 16
    rotation: 0
    state: enabled
- name: amp_base
  id: variable
  parameters:
    comment: 'Amplitud del tono sin compensar: deja las

      lineas unos 3 dB por debajo de 0 dBm'
    value: '0.25'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1798
    - 16
    rotation: 0
    state: enabled
- name: amp_max
  id: variable
  parameters:
    comment: Amplitud maxima del tono. No debe llegar a 1
    value: '0.95'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2128
    - 16
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import os
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2458
    - 16
    rotation: 0
    state: enabled
- name: f_primera
  id: variable
  parameters:
    comment: Primera linea del peine
    value: 60e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 200
    rotation: 0
    state: enabled
- name: paso_lineas
  id: variable
  parameters:
    comment: Separacion entre lineas
    value: 40e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 200
    rotation: 0
    state: enabled
- name: n_lineas
  id: variable
  parameters:
    comment: 'Cantidad de lineas: 24, de 60 a 980 MHz'
    value: '24'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 200
    rotation: 0
    state: enabled
- name: permanencia
  id: variable
  parameters:
    comment: 'Segundos en cada linea. Tiene que ser mayor

      que un barrido del analizador (2,8 s en la

      tinySA para toda la banda)'
    value: '6.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 200
    rotation: 0
    state: enabled
- name: archivo
  id: variable
  parameters:
    comment: 'Archivo donde se guarda la calibracion, en

      la carpeta del flujo'
    value: '''calibracion_peine_desde60.txt'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 200
    rotation: 0
    state: enabled
- name: estado_archivo
  id: variable
  parameters:
    comment: 'Texto sobre el archivo de calibracion. Lo

      cambian los botones'
    value: '''hay una guardada, sin importar'' if os.path.exists(archivo) else ''todavia
      no hay ninguna guardada'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1726
    - 200
    rotation: 0
    state: enabled
- name: muestras_por_bloque
  id: variable
  parameters:
    comment: 'Muestras en cada envio por USB. Con bloques

      grandes anduvieron los 40 MSPS en el EXP-22;

      con 4096 titilaba el LED a 30 MSPS'
    value: '16384'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2458
    - 200
    rotation: 0
    state: enabled
- name: bloques_usb
  id: variable
  parameters:
    comment: 'Bloques en espera. Con 128 x 16384 la

      amplitud tarda 0,05 s en llegar a la salida'
    value: '128'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2821
    - 200
    rotation: 0
    state: enabled
- name: lista_de_pasos
  id: variable
  parameters:
    comment: 'Los pasos del barrido: 0, 1, 2, ...'
    value: list(range(100000))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 400
    rotation: 0
    state: enabled
- name: paso
  id: variable_function_probe
  parameters:
    block_id: lista_de_pasos
    comment: 'Cada ''permanencia'' segundos saca el primer

      numero de la lista: es el paso actual'
    function_args: '0'
    function_name: pop
    poll_rate: 1.0 / permanencia
    value: '-1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 400
    rotation: 0
    state: enabled
- name: pasos_por_pasada
  id: variable
  parameters:
    comment: 'Recorriendo por nivel se agrega un paso en

      silencio al final de cada pasada'
    value: n_lineas + 1 if orden_recorrido == 1 else n_lineas
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 736
    - 400
    rotation: 0
    state: enabled
- name: posicion
  id: variable
  parameters:
    comment: Lugar dentro de la pasada, desde 0
    value: max(paso, 0) % pasos_por_pasada
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 400
    rotation: 0
    state: enabled
- name: pasada
  id: variable
  parameters:
    comment: Cuantas veces se recorrio el peine
    value: max(paso, 0) // pasos_por_pasada + 1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1726
    - 400
    rotation: 0
    state: enabled
- name: orden
  id: variable
  parameters:
    comment: 'En que orden se visitan las lineas: por

      frecuencia, o de la menos compensada a la

      mas compensada'
    value: 'sorted(range(n_lineas), key=lambda p: comp[p]) if orden_recorrido == 1
      else list(range(n_lineas))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 600
    rotation: 0
    state: enabled
- name: indice
  id: variable
  parameters:
    comment: 'Linea actual, de 0 a n_lineas - 1. El valor

      n_lineas es el paso en silencio del final de

      la pasada'
    value: orden[posicion] if posicion < n_lineas else n_lineas
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 600
    rotation: 0
    state: enabled
- name: entre_pasadas
  id: variable
  parameters:
    comment: 1 durante el paso en silencio
    value: 1 if indice >= n_lineas else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1126
    - 600
    rotation: 0
    state: enabled
- name: indice_freq
  id: variable
  parameters:
    comment: 'Durante el paso en silencio la placa se

      queda en la ultima linea'
    value: orden[n_lineas - 1] if indice >= n_lineas else indice
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1516
    - 600
    rotation: 0
    state: enabled
- name: linea
  id: variable
  parameters:
    comment: Frecuencia de la linea actual
    value: f_primera + paso_lineas * indice_freq
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2056
    - 600
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: 'Frecuencia de la portadora: ''separacion'' MHz

      por encima de la linea'
    value: linea - f_tono
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2458
    - 600
    rotation: 0
    state: enabled
- name: pausa
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    gui_hint: 1,0,1,2
    label: 'PAUSA: la salida queda en silencio. Destildar para transmitir'
    type: int
    'true': '1'
    'false': '0'
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 800
    rotation: 0
    state: enabled
- name: orden_recorrido
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,8,1,2
    label: Orden
    labels: '[''Por frecuencia'', ''De menor a mayor nivel'']'
    options: '[0, 1]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '0'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 800
    rotation: 0
    state: enabled
- name: ganancia
  id: variable_qtgui_chooser
  parameters:
    comment: 'Tres puntos, de a 10 dB. La compensacion es

      la misma en los tres'
    gui_hint: 1,2,1,2
    label: Ganancia de TX
    labels: '[''45 dB: lineas en -20 dBm'', ''55 dB: lineas en -10 dBm'', ''65 dB:
      lineas en 0 dBm'']'
    options: '[45, 55, 65]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '45'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 800
    rotation: 0
    state: enabled
- name: subida
  id: variable_qtgui_chooser
  parameters:
    comment: 'La calibracion es siempre a 0 dBm (con

      ganancia 65). Esto le suma 3 dB a todas las

      lineas que ya tienen valor cargado'
    gui_hint: 1,4,1,2
    label: Nivel
    labels: '[''Calibrado'', ''Calibrado + 3 dB'']'
    options: '[0, 3]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '0'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 800
    rotation: 0
    state: enabled
- name: separacion
  id: variable
  parameters:
    comment: 'MHz entre la linea y la portadora. Con

      lineas cada 40 MHz tiene que ser 10: asi los

      armonicos caen a multiplos de 40 MHz de la

      linea'
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 800
    rotation: 0
    state: enabled
- name: boton_generar
  id: variable_qtgui_push_button
  parameters:
    comment: 'Vale 1 mientras esta apretado. La accion

      esta en el Python Snippet'
    gui_hint: 4,0,1,4
    label: Generar calibracion (desde la captura .csv)
    type: int
    value: '0'
    pressed: '1'
    released: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 800
    rotation: 0
    state: enabled
- name: boton_guardar
  id: variable_qtgui_push_button
  parameters:
    comment: 'Vale 1 mientras esta apretado. La accion

      esta en el Python Snippet'
    gui_hint: 4,4,1,3
    label: Guardar calibracion
    type: int
    value: '0'
    pressed: '1'
    released: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1996
    - 800
    rotation: 0
    state: enabled
- name: boton_importar
  id: variable_qtgui_push_button
  parameters:
    comment: 'Vale 1 mientras esta apretado. La accion

      esta en el Python Snippet'
    gui_hint: 4,7,1,3
    label: Importar calibracion previa
    type: int
    value: '0'
    pressed: '1'
    released: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2326
    - 800
    rotation: 0
    state: enabled
- name: medidos
  id: variable
  parameters:
    comment: 'Valor leido en el analizador para cada

      linea, en dBm. 0 significa sin dato'
    value: '[m_60, m_100, m_140, m_180, m_220, m_260, m_300, m_340, m_380, m_420,
      m_460, m_500, m_540, m_580, m_620, m_660, m_700, m_740, m_780, m_820, m_860,
      m_900, m_940, m_980]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1060
    rotation: 0
    state: enabled
- name: comp
  id: variable
  parameters:
    comment: 'Compensacion de cada linea, en dB: lo que le

      falta para 0 dBm con ganancia 65. Sin dato,

      no compensa'
    value: '[(0.0 if leido == 0 else (ganancia_de_lectura - 65) - leido) for leido
      in medidos]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 477
    - 1060
    rotation: 0
    state: enabled
- name: pedido
  id: variable
  parameters:
    comment: 'Compensacion mas los 3 dB de subida, si

      estan elegidos. Las lineas sin dato quedan

      como estan'
    value: '[(0.0 if leido == 0 else comp[k] + subida) for k, leido in enumerate(medidos)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 939
    - 1060
    rotation: 0
    state: enabled
- name: amp_tabla
  id: variable
  parameters:
    comment: 'Amplitud del tono para cada linea, con tope

      en amp_max. El cero del final es el paso en

      silencio'
    value: '[min(amp_base * 10 ** (db / 20.0), amp_max) for db in pedido] + [0.0]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1402
    - 1060
    rotation: 0
    state: enabled
- name: sin_margen
  id: variable
  parameters:
    comment: Lineas que piden mas amplitud de la que hay
    value: sum(1 for db in pedido if amp_base * 10 ** (db / 20.0) > amp_max)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1930
    - 1060
    rotation: 0
    state: enabled
- name: cargadas
  id: variable
  parameters:
    comment: Lineas que ya tienen un valor cargado
    value: sum(1 for leido in medidos if leido != 0)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2458
    - 1060
    rotation: 0
    state: enabled
- name: emite
  id: variable
  parameters:
    comment: 1 cuando el flujo esta transmitiendo
    value: 1 if (pausa == 0 and paso >= 0) else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1260
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: 'Ganancia que recibe la placa: en pausa baja

      al minimo'
    value: ganancia if pausa == 0 else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 477
    - 1260
    rotation: 0
    state: enabled
- name: amp_tx
  id: variable
  parameters:
    comment: Amplitud del tono de esta linea
    value: amp_tabla[indice] if emite == 1 else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 874
    - 1260
    rotation: 0
    state: enabled
- name: nivel_sin_calibrar
  id: variable
  parameters:
    comment: 'Nivel aproximado de una linea sin calibrar,

      en dBm, segun la ganancia elegida'
    value: ganancia - 68
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1303
    - 1260
    rotation: 0
    state: enabled
- name: etapa
  id: variable
  parameters:
    comment: Texto de la etapa actual
    value: '''PAUSA (sin emitir)'' if pausa == 1 else (''INICIACION'' if paso < 0
      else (''SILENCIO ENTRE PASADAS'' if entre_pasadas == 1 else ''TRANSMISION, pasada
      %d'' % pasada))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1765
    - 1260
    rotation: 0
    state: enabled
- name: et_etapa
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,0,1,4
    label: '<span style=''font-size:15pt''>Etapa: </span>'
    type: string
    value: etapa
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1460
    rotation: 0
    state: enabled
- name: et_linea
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,4,1,3
    label: '<span style=''font-size:15pt''>Linea: </span>'
    type: string
    value: '''%.0f MHz (paso %d de %d)'' % (linea / 1e6, posicion + 1, pasos_por_pasada)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 1460
    rotation: 0
    state: enabled
- name: et_portadora
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,7,1,3
    label: '<span style=''font-size:15pt''>Portadora: </span>'
    type: string
    value: '''%.0f MHz'' % (freq / 1e6)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 1460
    rotation: 0
    state: enabled
- name: et_tiempos
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 3,7,1,3
    label: '<span style=''font-size:11pt''>Pasada completa: </span>'
    type: string
    value: '''%d min %02d s (%.0f s por linea)'' % (permanencia * pasos_por_pasada
      // 60, permanencia * pasos_por_pasada % 60, permanencia)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 1460
    rotation: 0
    state: enabled
- name: et_comp
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 2,4,1,3
    label: '<span style=''font-size:11pt''>Amplitud de esta linea: </span>'
    type: string
    value: '''%.3f (%+.1f dB sobre la base)'' % (amp_tabla[indice_freq], pedido[indice_freq])'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 1460
    rotation: 0
    state: enabled
- name: et_cargadas
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 3,0,1,4
    label: '<span style=''font-size:11pt''>Lineas con valor cargado: </span>'
    type: string
