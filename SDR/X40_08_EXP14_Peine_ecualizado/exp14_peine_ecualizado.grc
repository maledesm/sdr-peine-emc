    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 740
    rotation: 0
    state: enabled
- name: a_inf
  id: variable
  parameters:
    comment: Amplitud del tono inferior de la portadora en uso
    value: amps_inf[indice_activo]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
