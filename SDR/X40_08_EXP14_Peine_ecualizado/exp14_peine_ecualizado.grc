options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Peine por tandas de 300 a 510 MHz, calibracion de la placa al arrancar
      y una amplitud elegible por tono (ecualizador). Ganancia fija en 30
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: exp14_peine_ecualizado
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: EXP-14 peine calibrado con ecualizador
    window_size: (2700,2300)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import numpy as np
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 16
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Tasa de muestreo. Requiere USB 3
    value: 20e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 16
    rotation: 0
    state: enabled
- name: f_tono
  id: variable
  parameters:
    comment: Los dos tonos van en +f_tono y -f_tono
    value: 5e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 16
    rotation: 0
    state: enabled
- name: tasa_ctrl
  id: variable
  parameters:
    comment: Tasa de la rama de control del barrido
    value: 10e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 16
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: Ganancia de transmision fija. La tabla de fuga vale solo para esta ganancia
    value: '30'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 16
    rotation: 0
    state: enabled
- name: portadoras
  id: variable
  parameters:
    comment: 11 portadoras, de 305 a 505 MHz
    value: '[305e6 + 20e6*i for i in range(11)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1996
    - 16
    rotation: 0
    state: enabled
- name: modo
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 0,0,1,6
    label: Modo
    labels: '[]'
    options: '[0, 1, 2]'
    num_opts: '2'
    orient: Qt.QHBoxLayout
    type: real
    value: '0'
    widget: radio_buttons
    option0: '0'
    label0: Automatico
    option1: '1'
    label1: Manual
    option2: '2'
    label2: ''
    option3: '3'
    label3: ''
    option4: '4'
    label4: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 180
    rotation: 0
    state: enabled
- name: portadora_manual
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 0,6,1,6
    label: Portadora en modo manual
    labels: '[''305 MHz'', ''325 MHz'', ''345 MHz'', ''365 MHz'', ''385 MHz'', ''405
      MHz'', ''425 MHz'', ''445 MHz'', ''465 MHz'', ''485 MHz'', ''505 MHz'']'
    options: '[305000000, 325000000, 345000000, 365000000, 385000000, 405000000, 425000000,
      445000000, 465000000, 485000000, 505000000]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: real
    value: '305000000'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 180
    rotation: 0
    state: enabled
- name: permanencia
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,12,1,11
    label: Permanencia por portadora (s)
    min_len: '250'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '1'
    step: '0.5'
    stop: '20'
    value: '2'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 180
    rotation: 0
    state: enabled
- name: et_portadora
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.0f MHz'' % x'
    gui_hint: 1,0,1,5
    label: 'Portadora: '
    type: real
    value: freq / 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 420
    rotation: 0
    state: enabled
- name: et_inferior
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.0f MHz'' % x'
    gui_hint: 1,5,1,5
    label: 'Inferior: '
    type: real
    value: (freq - f_tono) / 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 420
    rotation: 0
    state: enabled
- name: et_superior
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.0f MHz'' % x'
    gui_hint: 1,10,1,5
    label: 'Superior: '
    type: real
    value: (freq + f_tono) / 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 420
    rotation: 0
    state: enabled
- name: et_paso
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%d de 11'' % x'
    gui_hint: 1,15,1,3
    label: 'Paso: '
    type: real
    value: indice_activo + 1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 420
    rotation: 0
    state: enabled
- name: et_pico
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: (''%.2f'' % x) if x <= 1 else (''%.2f RECORTA'' % x)'
    gui_hint: 1,18,1,5
    label: 'Pico: '
    type: real
    value: a_inf + a_sup
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 420
    rotation: 0
    state: enabled
- name: indice_medido
  id: variable_function_probe
  parameters:
    block_id: blocks_probe_signal_x_0
    comment: Lee la escalera de la rama de control
    function_args: ''
    function_name: level
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 580
    rotation: 0
    state: enabled
- name: indice
  id: variable
  parameters:
    comment: Paso del barrido automatico, desde 0
    value: min(max(int(round(indice_medido)), 0), len(portadoras) - 1)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 580
    rotation: 0
    state: enabled
- name: indice_activo
  id: variable
  parameters:
    comment: 'Portadora en uso: la manual o la del barrido'
    value: int(round((portadora_manual - portadoras[0]) / 20e6)) if modo == 1 else
      indice
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 580
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: Frecuencia del oscilador
    value: portadoras[indice_activo]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1766
    - 580
    rotation: 0
    state: enabled
- name: amps_inf
  id: variable
  parameters:
    comment: Amplitudes de los tonos inferiores
    value: '[amp_300, amp_320, amp_340, amp_360, amp_380, amp_400, amp_420, amp_440,
