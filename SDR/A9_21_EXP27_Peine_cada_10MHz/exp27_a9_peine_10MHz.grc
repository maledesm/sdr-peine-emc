    comment: 'Lo medido en la ultima irradiada, para el

      grafico (sin dato queda abajo)'
    value: '[(v if v != 0 else -100) for v in medido_irradiado]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 3106
    rotation: 0
    state: enabled
