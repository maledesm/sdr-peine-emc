    state: enabled
- name: nivel_respuesta
  id: variable
  parameters:
    comment: 'Lo que saldria en cada linea con la amplitud

      base, sin compensar, con la ganancia actual'
    value: '[(medidos[k] + ganancia - ganancia_de_lectura) if medidos[k] != 0 else
      -100 for k in range(n_lineas)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
