    rotation: 0
    state: enabled
- name: d_phi
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 5,2,1,2
    label: 'd: fase (grados)'
    min_len: '250'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-180'
    step: '0.5'
    stop: '180'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 204.0]
    rotation: 0
    state: enabled
- name: dcoef
  id: variable
  parameters:
    comment: 'Contra-modulacion:

      se suma d*x*exp(j*2*pi*f_esp*t)'
    value: d_on * 10**(d_db/20) * np.exp(1j*np.deg2rad(d_phi))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1296, 416.0]
    rotation: 0
    state: enabled
- name: e_db
