options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'bladeRF 2.0 micro xA9: portadora en 100 MHz, tono a 200 kHz, ganancia
      y amplitud ajustables en forma fina'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: exp15_a9_ganancia_amplitud
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'EXP-15 xA9: ganancia y amplitud'
    window_size: (1900,1100)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: Tasa de muestreo
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 16
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: Portadora
    value: 100e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 16
    rotation: 0
    state: enabled
- name: f_tono
  id: variable
  parameters:
    comment: El tono sale en freq + f_tono
    value: 200e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 16
    rotation: 0
    state: enabled
- name: tope
  id: variable_qtgui_chooser
  parameters:
    comment: Limita la ganancia aunque el deslizador este mas arriba
    gui_hint: 0,0,1,3
    label: Tope de seguridad de la ganancia
    labels: '[]'
    options: '[0, 1, 2]'
    num_opts: '5'
    orient: Qt.QHBoxLayout
    type: real
    value: '0'
    widget: radio_buttons
    option0: '0'
    label0: 0 dB
    option1: '20'
    label1: 20 dB
    option2: '40'
    label2: 40 dB
    option3: '55'
    label3: 55 dB
    option4: '66'
    label4: 66 dB (maximo)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 180
    rotation: 0
    state: enabled
- name: ganancia
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,3
    label: Ganancia pedida (dB)
    min_len: '400'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-23.75'
    step: '0.25'
    stop: '66'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 420
    rotation: 0
    state: enabled
- name: amp
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 2,0,1,3
    label: Amplitud del tono (0 a 1)
    min_len: '400'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.01'
    stop: '1'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 420
    rotation: 0
    state: enabled
- name: et_ganancia
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: (''%.2f dB'' % x)'
    gui_hint: 3,0,1,1
    label: 'Ganancia aplicada: '
    type: real
    value: tx_gain
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 620
    rotation: 0
    state: enabled
- name: et_limite
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''LIMITANDO'' if x else ''sin limitar'''
    gui_hint: 3,1,1,1
    label: 'Tope: '
    type: real
    value: 1 if ganancia > tope else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 620
    rotation: 0
    state: enabled
- name: et_amp
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.2f'' % x'
    gui_hint: 3,2,1,1
    label: 'Amplitud: '
    type: real
    value: amp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 620
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: 'Ganancia que se le manda a la placa: nunca supera el tope'
    value: min(ganancia, tope)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 780
    rotation: 0
    state: enabled
- name: aspecto
  id: snippet
  parameters:
    alias: ''
    comment: Letra grande en las etiquetas de estado
    priority: '0'
    section: main_after_init
    code: "# Las etiquetas de GNU Radio no tienen tamano de letra: se lo cambiamos\
      \ aca.\nfor nombre in ('et_ganancia', 'et_limite', 'et_amp'):\n    barra = getattr(self,\
      \ '_%s_tool_bar' % nombre)\n    ancho = 60\n    for accion in barra.actions():\n\
      \        etiqueta = barra.widgetForAction(accion)\n        etiqueta.setStyleSheet('font-size:\
      \ 15pt; font-weight: bold')\n        ancho += etiqueta.sizeHint().width()\n\
      \    barra.setMinimumWidth(ancho + 60)\nself.resize(self.top_widget.minimumSizeHint().width()\
      \ + 60, 330)\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 780
    rotation: 0
    state: enabled
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: amp
    comment: ''
    freq: f_tono
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 960
    rotation: 0
    state: enabled
