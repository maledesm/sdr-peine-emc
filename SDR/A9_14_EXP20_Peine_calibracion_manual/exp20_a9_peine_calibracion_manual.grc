options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'bladeRF 2.0 micro xA9: peine de 70 a 420 MHz. Sin calibrar, las
      lineas salen cerca de -3 dBm. En cada contador se carga el valor leido en el
      analizador y el flujo sube esa linea hasta 0 dBm. La calibracion se guarda en
      un archivo y se puede importar. SOLO para medir con el analizador: nunca con
      el cable en RX1'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: exp20_a9_peine_calibracion_manual
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'EXP-20 xA9: peine con calibracion manual por valor medido'
    window_size: (3000,3600)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'Tasa de muestreo. En esta PC no pasar de

      25e6'
    value: 20e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 16
    rotation: 0
    state: enabled
- name: f_tono
  id: variable
  parameters:
    comment: 'Cada portadora lleva dos tonos: en +f_tono y

      en -f_tono'
    value: 5e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 16
    rotation: 0
    state: enabled
- name: ancho_banda
  id: variable
  parameters:
    comment: Filtro analogico de la placa
    value: 18e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 16
    rotation: 0
    state: enabled
- name: ganancia_de_lectura
  id: variable
  parameters:
    comment: 'Ganancia de TX con la que se leen en el

      analizador los valores que se cargan en los

      contadores'
    value: '45'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 16
    rotation: 0
    state: enabled
- name: amp_base
  id: variable
  parameters:
    comment: 'Amplitud de cada tono sin compensar: deja

      las lineas unos 3 dB por debajo del nivel

      calibrado'
    value: '0.25'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 16
    rotation: 0
    state: enabled
- name: amp_max
  id: variable
  parameters:
    comment: 'Amplitud maxima de un tono. La suma de los

      dos no debe pasar de 0.95'
    value: '0.47'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1996
    - 16
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import os
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2326
    - 16
    rotation: 0
    state: enabled
- name: f_primera
  id: variable
  parameters:
    comment: 'Primera portadora. Sus lineas salen en 70 y

      80 MHz'
    value: 75e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 200
    rotation: 0
    state: enabled
- name: paso_port
  id: variable
  parameters:
    comment: Separacion entre portadoras
    value: 20e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 200
    rotation: 0
    state: enabled
- name: n_port
  id: variable
  parameters:
    comment: 'Cantidad de portadoras: 18 dan 36 lineas, de

      70 a 420 MHz'
    value: '18'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 200
    rotation: 0
    state: enabled
- name: permanencia
  id: variable
  parameters:
    comment: 'Segundos en cada portadora. Tiene que ser

      mayor que un barrido del analizador'
    value: '2.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 200
    rotation: 0
    state: enabled
- name: archivo
  id: variable
  parameters:
    comment: 'Archivo donde se guarda la calibracion, en

      la carpeta del flujo'
    value: '''calibracion_peine.txt'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 200
    rotation: 0
    state: enabled
- name: estado_archivo
  id: variable
  parameters:
    comment: 'Texto sobre el archivo de calibracion. Lo

      cambian los botones'
    value: '''hay una guardada, sin importar'' if os.path.exists(archivo) else ''todavia
      no hay ninguna guardada'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1726
    - 200
    rotation: 0
    state: enabled
- name: lista_de_pasos
  id: variable
  parameters:
    comment: 'Los pasos del barrido: 0, 1, 2, ...'
    value: list(range(100000))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 400
    rotation: 0
    state: enabled
- name: paso
  id: variable_function_probe
  parameters:
    block_id: lista_de_pasos
    comment: 'Cada ''permanencia'' segundos saca el primer

      numero de la lista: es el paso actual'
    function_args: '0'
    function_name: pop
    poll_rate: 1.0 / permanencia
    value: '-1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 400
    rotation: 0
    state: enabled
- name: pasos_por_pasada
  id: variable
  parameters:
    comment: 'Recorriendo por nivel se agrega un paso en

      silencio al final de cada pasada'
    value: n_port + 1 if orden_recorrido == 1 else n_port
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 736
    - 400
    rotation: 0
    state: enabled
- name: posicion
  id: variable
  parameters:
    comment: Lugar dentro de la pasada, desde 0
    value: max(paso, 0) % pasos_por_pasada
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 400
    rotation: 0
    state: enabled
- name: pasada
  id: variable
  parameters:
    comment: Cuantas veces se recorrio el peine
    value: max(paso, 0) // pasos_por_pasada + 1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1726
    - 400
    rotation: 0
    state: enabled
- name: orden
  id: variable
  parameters:
    comment: 'En que orden se visitan las portadoras: por

      frecuencia, o de la menos compensada a la

      mas compensada'
    value: 'sorted(range(n_port), key=lambda p: comp[2 * p] + comp[2 * p + 1]) if
      orden_recorrido == 1 else list(range(n_port))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 600
    rotation: 0
    state: enabled
- name: indice
  id: variable
  parameters:
    comment: 'Portadora actual, de 0 a n_port - 1. El

      valor n_port es el paso en silencio del

      final de la pasada'
    value: orden[posicion] if posicion < n_port else n_port
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 600
    rotation: 0
    state: enabled
- name: entre_pasadas
  id: variable
  parameters:
    comment: 1 durante el paso en silencio
    value: 1 if indice >= n_port else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1126
    - 600
    rotation: 0
    state: enabled
- name: indice_freq
  id: variable
  parameters:
    comment: 'Durante el paso en silencio la placa se

      queda en la ultima portadora'
    value: orden[n_port - 1] if indice >= n_port else indice
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1516
    - 600
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: Frecuencia de la portadora actual
    value: f_primera + paso_port * indice_freq
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2116
    - 600
    rotation: 0
    state: enabled
- name: pausa
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    gui_hint: 1,0,1,3
    label: 'PAUSA: la salida queda en silencio. Destildar para transmitir'
    type: int
    'true': '1'
    'false': '0'
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 800
    rotation: 0
    state: enabled
- name: orden_recorrido
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,6,1,3
    label: Orden de recorrido
    labels: '[''Por frecuencia'', ''De menor a mayor nivel (evita el efecto del retardo)'']'
    options: '[0, 1]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '0'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 800
    rotation: 0
    state: enabled
- name: ganancia
  id: variable_qtgui_chooser
  parameters:
    comment: 'Tres puntos: se calibra en el mas bajo y se

      sube de a 10 dB. La compensacion es la misma

      en los tres'
    gui_hint: 1,3,1,3
    label: Ganancia de TX
    labels: '[''45 dB: para leer y calibrar (lineas en -20 dBm)'', ''55 dB: lineas
      en -10 dBm'', ''65 dB: lineas en 0 dBm'']'
    options: '[45, 55, 65]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '45'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1396
    - 800
    rotation: 0
    state: enabled
- name: boton_guardar
  id: variable_qtgui_push_button
  parameters:
    comment: 'Vale 1 mientras esta apretado. La accion

      esta en el Python Snippet'
    gui_hint: 4,0,1,2
    label: Guardar calibracion
    type: int
    value: '0'
    pressed: '1'
    released: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 800
    rotation: 0
    state: enabled
- name: boton_importar
  id: variable_qtgui_push_button
  parameters:
    comment: 'Vale 1 mientras esta apretado. La accion

      esta en el Python Snippet'
    gui_hint: 4,2,1,2
    label: Importar calibracion previa
    type: int
    value: '0'
    pressed: '1'
    released: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 800
    rotation: 0
    state: enabled
- name: medidos
  id: variable
  parameters:
    comment: 'Valor leido en el analizador para cada

      linea, en dBm. 0 significa sin dato'
    value: '[m_70, m_80, m_90, m_100, m_110, m_120, m_130, m_140, m_150, m_160, m_170,
      m_180, m_190, m_200, m_210, m_220, m_230, m_240, m_250, m_260, m_270, m_280,
      m_290, m_300, m_310, m_320, m_330, m_340, m_350, m_360, m_370, m_380, m_390,
      m_400, m_410, m_420]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1060
    rotation: 0
    state: enabled
- name: comp
  id: variable
  parameters:
    comment: 'Compensacion de cada linea, en dB: lo que le

      falta para el nivel calibrado (0 dBm con

      ganancia 65, -20 dBm con 45). Sin dato, no

      compensa'
    value: '[(0.0 if leido == 0 else (ganancia_de_lectura - 65) - leido) for leido
      in medidos]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 477
    - 1060
    rotation: 0
    state: enabled
- name: amp_tabla
  id: variable
  parameters:
    comment: 'Amplitud de cada tono ya compensada, con

      tope en amp_max. Los dos ceros del final son

      el paso en silencio'
    value: '[min(amp_base * 10 ** (db / 20.0), amp_max) for db in comp] + [0.0, 0.0]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 939
    - 1060
    rotation: 0
    state: enabled
- name: sin_margen
  id: variable
  parameters:
    comment: 'Lineas que piden mas compensacion de la que

      hay'
    value: sum(1 for db in comp if amp_base * 10 ** (db / 20.0) > amp_max)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1533
    - 1060
    rotation: 0
    state: enabled
- name: cargadas
  id: variable
  parameters:
    comment: Lineas que ya tienen un valor cargado
    value: sum(1 for leido in medidos if leido != 0)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2062
    - 1060
    rotation: 0
    state: enabled
- name: emite
  id: variable
  parameters:
    comment: '1 cuando el flujo esta transmitiendo (ni en

      pausa ni arrancando)'
    value: 1 if (pausa == 0 and paso >= 0) else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1260
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: 'Ganancia que recibe la placa: en pausa baja

      al minimo'
    value: ganancia if pausa == 0 else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 577
    - 1260
    rotation: 0
    state: enabled
- name: amp_inf_tx
  id: variable
  parameters:
    comment: Amplitud del tono inferior de esta portadora
    value: amp_tabla[2 * indice] if emite == 1 else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 973
    - 1260
    rotation: 0
    state: enabled
- name: amp_sup_tx
  id: variable
  parameters:
    comment: Amplitud del tono superior de esta portadora
    value: amp_tabla[2 * indice + 1] if emite == 1 else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1435
    - 1260
    rotation: 0
    state: enabled
- name: etapa
  id: variable
  parameters:
    comment: Texto de la etapa actual
    value: '''PAUSA (sin emitir)'' if pausa == 1 else (''INICIACION'' if paso < 0
      else (''SILENCIO ENTRE PASADAS'' if entre_pasadas == 1 else ''TRANSMISION, pasada
      %d'' % pasada))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1930
    - 1260
    rotation: 0
    state: enabled
- name: et_etapa
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,0,1,3
    label: '<span style=''font-size:15pt''>Etapa: </span>'
    type: string
    value: etapa
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1460
    rotation: 0
    state: enabled
- name: et_portadora
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,3,1,3
    label: '<span style=''font-size:15pt''>Portadora: </span>'
    type: string
    value: '''%.0f MHz (paso %d de %d)'' % (freq / 1e6, posicion + 1, pasos_por_pasada)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 1460
    rotation: 0
    state: enabled
- name: et_lineas
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,6,1,3
    label: '<span style=''font-size:15pt''>Lineas: </span>'
    type: string
    value: '''%.0f y %.0f MHz'' % ((freq - f_tono) / 1e6, (freq + f_tono) / 1e6)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 1460
    rotation: 0
    state: enabled
- name: et_tiempos
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 2,6,1,3
    label: '<span style=''font-size:11pt''>Pasada completa: </span>'
    type: string
    value: '''%.0f s (%.1f s por portadora)'' % (permanencia * pasos_por_pasada, permanencia)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 1460
    rotation: 0
    state: enabled
- name: et_comp
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 2,3,1,3
    label: '<span style=''font-size:11pt''>Compensacion de estas dos lineas: </span>'
    type: string
    value: '''%+.1f y %+.1f dB'' % (comp[2 * indice_freq], comp[2 * indice_freq +
      1])'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 1460
    rotation: 0
    state: enabled
- name: et_cargadas
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 3,0,1,3
    label: '<span style=''font-size:11pt''>Lineas con valor cargado: </span>'
    type: string
    value: '''%d de %d'' % (cargadas, 2 * n_port)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 1460
    rotation: 0
    state: enabled
- name: et_margen
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 3,3,1,3
    label: '<span style=''font-size:11pt''>Lineas que piden mas de lo que hay: </span>'
    type: int
    value: sin_margen
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1996
    - 1460
    rotation: 0
    state: enabled
- name: et_archivo
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 4,4,1,5
    label: '<span style=''font-size:11pt''>Calibracion en archivo: </span>'
    type: string
    value: estado_archivo
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1640
    rotation: 0
    state: enabled
- name: et_titulo
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''>" + str(x) + "</span>"'
    gui_hint: 5,0,1,9
    label: '<span style=''font-size:11pt''><b>Valor leido en el analizador para cada
      linea (MHz), en dBm: </b></span>'
    type: string
    value: '''con MAX HOLD, con la ganancia de TX en %d dB y con ese contador en 0''
      % ganancia_de_lectura'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 1640
    rotation: 0
    state: enabled
- name: et_nivel
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 2,0,1,3
    label: '<span style=''font-size:11pt''>Con esta ganancia: </span>'
    type: string
    value: '''sin calibrar unos %d dBm, calibradas %d dBm'' % (ganancia - 68, ganancia
      - 65)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 736
    - 1640
    rotation: 0
    state: enabled
- name: tono_superior
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: Sale en portadora + 5 MHz
    maxoutbuf: '0'
    minoutbuf: '0'
    amp: amp_sup_tx
    freq: f_tono
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1840
    rotation: 0
