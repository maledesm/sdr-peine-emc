- name: guardar_e_importar
  id: snippet
  parameters:
    alias: ''
    comment: 'Guarda la calibracion en un archivo y la

      vuelve a cargar'
    priority: '0'
    section: main_after_init
    code: "# ============================================================================\n\
      # GUARDAR E IMPORTAR LA CALIBRACION\n# Es el unico codigo Python del flujo.\
      \ Hace falta porque los bloques no saben\n# escribir ni leer un archivo con\
      \ valores.\n#   Boton \"Guardar calibracion\": escribe en un archivo de texto\
      \ los 36 valores\n#   cargados en la ventana, uno por renglon, junto a su frecuencia.\n\
      #   Boton \"Importar calibracion previa\": lee ese archivo y pone cada valor\
      \ en\n#   su contador.\n# ============================================================================\n\
      import os\nimport time\n\n# Los 36 contadores de la ventana, en orden de frecuencia\
      \ (70, 80, ... 420 MHz).\n# d_widget es la casilla con flechas que se ve en\
      \ pantalla.\ncontadores = [\n    self._m_70_win.d_widget, self._m_80_win.d_widget,\
      \ self._m_90_win.d_widget,\n    self._m_100_win.d_widget, self._m_110_win.d_widget,\
      \ self._m_120_win.d_widget,\n    self._m_130_win.d_widget, self._m_140_win.d_widget,\
      \ self._m_150_win.d_widget,\n    self._m_160_win.d_widget, self._m_170_win.d_widget,\
      \ self._m_180_win.d_widget,\n    self._m_190_win.d_widget, self._m_200_win.d_widget,\
      \ self._m_210_win.d_widget,\n    self._m_220_win.d_widget, self._m_230_win.d_widget,\
      \ self._m_240_win.d_widget,\n    self._m_250_win.d_widget, self._m_260_win.d_widget,\
      \ self._m_270_win.d_widget,\n    self._m_280_win.d_widget, self._m_290_win.d_widget,\
      \ self._m_300_win.d_widget,\n    self._m_310_win.d_widget, self._m_320_win.d_widget,\
      \ self._m_330_win.d_widget,\n    self._m_340_win.d_widget, self._m_350_win.d_widget,\
      \ self._m_360_win.d_widget,\n    self._m_370_win.d_widget, self._m_380_win.d_widget,\
      \ self._m_390_win.d_widget,\n    self._m_400_win.d_widget, self._m_410_win.d_widget,\
      \ self._m_420_win.d_widget,\n]\n\n\ndef guardar():\n    valores = self.get_medidos()\
      \                 # los 36 valores de la ventana\n    try:\n        archivo\
      \ = open(self.get_archivo(), 'w')\n        # primer renglon: cuando se guardo\
      \ y con que ganancia se leyeron los valores\n        archivo.write('# guardada\
      \ el ' + time.strftime('%d-%m-%Y %H:%M') +\n                      ', valores\
      \ leidos con ganancia %d dB\\n' % self.get_ganancia_de_lectura())\n        for\
      \ k in range(len(valores)):\n            frecuencia = 70 + 10 * k\n        \
      \    archivo.write('%d %.1f\\n' % (frecuencia, valores[k]))\n        archivo.close()\n\
      \    except Exception:\n        self.set_estado_archivo('NO se pudo guardar')\n\
      \        return\n    self.set_estado_archivo('guardada a las ' + time.strftime('%H:%M:%S'))\n\
      \n\ndef importar():\n    if not os.path.exists(self.get_archivo()):\n      \
      \  self.set_estado_archivo('no hay ninguna calibracion guardada')\n        return\n\
      \    try:\n        archivo = open(self.get_archivo())\n        renglones = archivo.readlines()\n\
      \        archivo.close()\n        if renglones[0].startswith('#'):\n       \
      \     renglones = renglones[1:]            # se saltea el renglon de encabezado\n\
      \        valores = []\n        for k in range(len(contadores)):\n          \
      \  partes = renglones[k].split()        # cada renglon: frecuencia y valor\n\
      \            valores.append(float(partes[1]))\n    except Exception:\n     \
      \   self.set_estado_archivo('el archivo no se pudo leer: no se importo nada')\n\
      \        return\n    for k in range(len(contadores)):\n        contadores[k].setValue(valores[k])\
      \       # al cambiar el contador, el flujo se actualiza solo\n    self.set_estado_archivo('importada\
      \ a las ' + time.strftime('%H:%M:%S'))\n\n\n# GNU Radio llama a set_boton_guardar(1)\
      \ cuando se aprieta el boton y a\n# set_boton_guardar(0) cuando se suelta. Aca\
      \ se define que hace esa llamada.\ndef al_tocar_guardar(valor):\n    if valor\
      \ == 1:\n        guardar()\n\n\ndef al_tocar_importar(valor):\n    if valor\
      \ == 1:\n        importar()\n\n\nself.set_boton_guardar = al_tocar_guardar\n\
      self.set_boton_importar = al_tocar_importar\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 3460
    rotation: 0
    state: enabled
connections:
- - tono_superior
  - '0'
  - suma
  - '0'
- - tono_inferior
  - '0'
  - suma
  - '1'
