options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'bladeRF 2.0 micro xA9: 96 lineas cada 10 MHz de 50 a 1000 MHz, un
      tono por portadora, con la portadora 6,25 o 10 MHz por encima de la linea y
      40 MSPS. Reiniciar deja todas las lineas con la misma amplitud y el objetivo
      plano. Calibracion conducida con la tinySA hacia el objetivo, calibracion irradiada
      relativa con las trazas .DAT del receptor del laboratorio hacia CISPR 11 grupo
      1 clase A, y patron por cable para repetir la emision otro dia. SOLO hacia la
      tinySA o la antena: nunca con el cable en RX1'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: exp28_a9_peine
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'EXP-28 xA9: peine cada 10 MHz calibrado hacia CISPR 11 grupo 1 clase A'
    window_size: (4200,3600)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 3216
    - 16
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'Tasa de muestreo atada a la separacion: 20

      MSPS con la portadora a 6,25 MHz y 30 MSPS

      con 10 MHz. La imagen del muestreo cae 20 o

      30 MHz arriba de la linea, sobre la grilla.

      Cambiar la separacion solo en PAUSA'
    value: 20e6 if separacion == 6.25 else 30e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
- name: ancho_banda
  id: variable
  parameters:
    comment: Filtro analogico de la placa
    value: 0.9 * samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 416
    - 16
    rotation: 0
    state: enabled
- name: f_primera
  id: variable
  parameters:
    comment: Primera linea del peine
    value: 50e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 816
    - 16
    rotation: 0
    state: enabled
- name: paso_lineas
  id: variable
  parameters:
    comment: Separacion entre lineas
    value: 10e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1216
    - 16
    rotation: 0
    state: enabled
- name: n_lineas
  id: variable
  parameters:
    comment: 'Cantidad de lineas: 96, de 50 a 1000 MHz'
    value: '96'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1616
    - 16
    rotation: 0
    state: enabled
- name: muestras_por_bloque
  id: variable
  parameters:
    comment: 'Muestras en cada envio por USB. Con bloques

      grandes anduvieron los 40 MSPS en el EXP-22'
    value: '16384'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2016
    - 16
    rotation: 0
    state: enabled
- name: bloques_usb
  id: variable
  parameters:
    comment: 'Bloques USB de 16384 muestras: 64 guardan 52

      ms a 20 MSPS y 35 ms a 30 MSPS. La amplitud

      llega a la salida con ese retardo, por eso

      el corte minimo es de 0,2 s'
    value: '64'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2416
    - 16
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: 'import os

      import math'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2816
    - 16
    rotation: 0
    state: enabled
- name: ganancia_de_lectura
  id: variable
  parameters:
    comment: 'Ganancia de TX a la que esta referida la

      respuesta de la placa'
    value: '45'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 216
    rotation: 0
    state: enabled
- name: amp_base
  id: variable
  parameters:
    comment: Amplitud del tono sin compensar
    value: '0.25'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 416
    - 216
    rotation: 0
    state: enabled
- name: amp_max
  id: variable
  parameters:
    comment: Amplitud maxima del tono. No debe llegar a 1
    value: '0.95'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 816
    - 216
    rotation: 0
    state: enabled
- name: prefijo
  id: variable
  parameters:
    comment: 'Comienzo del nombre de los archivos de esta

      version, para que no se mezclen con los de

      las otras'
    value: ''''''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1216
    - 216
    rotation: 0
    state: enabled
- name: texto_salida
  id: variable
  parameters:
    comment: Se muestra en la ventana
    value: '''bladeRF xA9, TX1'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1216
    - 326
    rotation: 0
    state: enabled
- name: archivo_cal
  id: variable
  parameters:
    comment: 'Archivo de la calibracion conducida, en la

      carpeta del flujo'
    value: prefijo + 'calibracion_conducida.txt'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1616
    - 216
    rotation: 0
    state: enabled
- name: archivo_obj
  id: variable
  parameters:
    comment: 'Archivo del objetivo actual. Se carga solo

      al abrir el programa'
    value: prefijo + 'objetivo.txt'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2016
    - 216
    rotation: 0
    state: enabled
- name: archivo_irr
  id: variable
  parameters:
    comment: 'Lo medido en la ultima calibracion

      irradiada. Se carga solo al abrir'
    value: prefijo + 'ultima_irradiada.txt'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2416
    - 216
    rotation: 0
    state: enabled
- name: objetivo
  id: variable
  parameters:
    comment: 'Nivel por cable de cada linea, en dBm. Lo

      carga el snippet desde el archivo. No

      depende de nivel_inicial a proposito:

      cambiar ese campo no tiene que pisar la

      calibracion'
    value: '[-33.0] * n_lineas'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2816
    - 216
    rotation: 0
    state: enabled
- name: estado_cal
  id: variable
  parameters:
    comment: 'Texto sobre la calibracion conducida. Lo

      cambian los botones'
    value: ''''''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 476
    rotation: 0
    state: enabled
- name: estado_obj
  id: variable
  parameters:
    comment: 'Texto sobre el objetivo. Lo cambian los

      botones'
    value: ''''''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 416
    - 476
    rotation: 0
    state: enabled
- name: estado_irr
  id: variable
  parameters:
    comment: Texto sobre la ultima calibracion irradiada
    value: ''''''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 816
    - 476
    rotation: 0
    state: enabled
- name: medido_irradiado
  id: variable
  parameters:
    comment: 'Mayor nivel de las trazas en cada linea en la

      ultima calibracion irradiada, en dBuV/m'
    value: '[0.0] * n_lineas'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1216
    - 476
    rotation: 0
    state: enabled
- name: separacion_cal
  id: variable
  parameters:
    comment: 'Separacion de la portadora con que se hizo la

      calibracion conducida cargada. 0 es que no

      se sabe. La ponen los botones'
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1616
    - 476
    rotation: 0
    state: enabled
- name: pausa
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    gui_hint: 1,0,1,4
    label: 'PAUSA: salida en silencio. Destildar para transmitir'
    type: int
    'true': '1'
    'false': '0'
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 676
    rotation: 0
    state: enabled
- name: congelar
  id: variable_qtgui_check_box
  parameters:
    comment: 'Detiene el barrido en la linea que esta

      saliendo y la deja emitiendo. Al destildar,

      el barrido sigue desde ahi'
    gui_hint: 1,4,1,4
    label: CONGELAR en la linea actual (sigue emitiendo)
    type: int
    'true': '1'
    'false': '0'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 416
    - 676
    rotation: 0
    state: enabled
- name: silencio
  id: variable_qtgui_check_box
  parameters:
    comment: 'Tildada: despues de cada linea encendida

      viene el mismo tiempo apagada'
    gui_hint: 1,8,1,4
    label: 'Silencio largo: cada linea queda apagada otro tanto'
    type: int
    'true': '1'
    'false': '0'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 816
    - 676
    rotation: 0
    state: enabled
- name: ganancia
  id: variable_qtgui_range
  parameters:
    comment: 'Tope de 55 dB: la tinySA va sin atenuador

      y aguanta +6 dBm'
    gui_hint: 2,0,1,3
    label: Ganancia de TX (dB)
    min_len: '50'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '55'
    value: '31'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1216
    - 676
    rotation: 0
    state: enabled
- name: separacion
  id: variable_qtgui_chooser
  parameters:
    comment: MHz entre la linea y la portadora
    gui_hint: 2,3,1,3
    label: Portadora sobre la linea
    labels: '[''6,25 MHz'', ''10 MHz'']'
    options: '[6.25, 10]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: real
    value: '6.25'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1616
    - 676
    rotation: 0
    state: enabled
- name: fijo
  id: variable_qtgui_chooser
  parameters:
    comment: 'Barrido completo, o una sola linea emitida

      en forma continua (para orientar las antenas

      o mirar sus armonicos)'
    gui_hint: 2,6,1,3
    label: Modo
    labels: '[''Barrido completo''] + [''Fija en %d MHz'' % (50 + 10 * k) for k in
      range(96)]'
    options: '[-1] + list(range(96))'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '-1'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2016
    - 676
    rotation: 0
    state: enabled
- name: permanencia
  id: variable_qtgui_range
  parameters:
    comment: 'Tiene que superar dos barridos del receptor.

      Cambiarla en PAUSA: el barrido se reacomoda'
    gui_hint: 3,0,1,3
    label: Segundos encendida por linea
    min_len: '50'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '1'
    step: '0.5'
    stop: '30'
    value: '7'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 876
    rotation: 0
    state: enabled
- name: corte
  id: variable_qtgui_range
  parameters:
    comment: 'Tono apagado alrededor de cada salto, para

      que el MAX HOLD no tome el salto. Minimo 0,2 s:

      la amplitud tarda 0,05 s en llegar'
    gui_hint: 3,3,1,3
    label: Corte en cada salto (s)
    min_len: '50'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.2'
    step: '0.1'
    stop: '3'
    value: '0.5'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 416
    - 876
    rotation: 0
    state: enabled
- name: lista_de_pasos
  id: variable
  parameters:
    comment: 'Los pasos del barrido. pop() saca el ultimo:

      0, 1, 2, ... (alcanza para mas de 27 horas)'
    value: list(range(1000000 - 1, -1, -1))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 816
    - 876
    rotation: 0
    state: enabled
- name: paso
  id: variable_function_probe
  parameters:
    block_id: lista_de_pasos
    comment: 'Cada decima de segundo saca el ultimo numero

      de la lista: cuenta decimas desde el arranque'
    function_args: ''
    function_name: pop
    poll_rate: '10'
    value: '-1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1216
    - 876
    rotation: 0
    state: enabled
- name: decima
  id: variable
  parameters:
    comment: Decimas de segundo desde el arranque
    value: max(paso, 0)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1096
    rotation: 0
    state: enabled
- name: encendido
  id: variable
  parameters:
    comment: Decimas con el tono encendido en cada linea
    value: int(round(10 * permanencia))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 416
    - 1096
    rotation: 0
    state: enabled
- name: apagado
  id: variable
  parameters:
    comment: 'Decimas apagado entre dos lineas: el corte,

      mas el silencio largo si esta tildado'
    value: int(round(10 * (corte + (permanencia if silencio == 1 else 0))))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 816
    - 1096
    rotation: 0
    state: enabled
- name: antes
  id: variable
  parameters:
    comment: 'Decimas apagado al principio de cada linea.

      El resto va al final: asi el salto queda en

      el medio del apagado'
    value: apagado // 2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1216
    - 1096
    rotation: 0
    state: enabled
- name: por_linea
  id: variable
  parameters:
    comment: 'Decimas por linea: apagado y encendido'
    value: encendido + apagado
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1616
    - 1096
    rotation: 0
    state: enabled
- name: ciclo
  id: variable
  parameters:
    comment: Numero de linea desde el arranque
    value: decima // por_linea
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2016
    - 1096
    rotation: 0
    state: enabled
- name: dentro
  id: variable
  parameters:
    comment: Decimas dentro de la linea actual
    value: decima % por_linea
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2416
    - 1096
    rotation: 0
    state: enabled
- name: en_corte
  id: variable
  parameters:
    comment: 1 mientras el tono esta apagado
    value: 0 if antes <= dentro < antes + encendido else 1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2816
    - 1096
    rotation: 0
    state: enabled
- name: posicion
  id: variable
  parameters:
    comment: Lugar dentro de la pasada, desde 0
    value: ciclo % n_lineas
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1296
    rotation: 0
    state: enabled
- name: pasada
  id: variable
  parameters:
    comment: Cuantas veces se recorrio el peine
    value: ciclo // n_lineas + 1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 416
    - 1296
    rotation: 0
    state: enabled
- name: indice
  id: variable
  parameters:
    comment: Linea actual, de 0 a 95
    value: fijo if fijo >= 0 else posicion
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 816
    - 1296
    rotation: 0
    state: enabled
- name: linea
  id: variable
  parameters:
    comment: Frecuencia de la linea actual
    value: f_primera + paso_lineas * indice
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1216
    - 1296
    rotation: 0
    state: enabled
- name: f_tono
  id: variable
  parameters:
    comment: 'El tono va por debajo de la portadora: asi

      la linea de 50 MHz no obliga a sintonizar

      por debajo de 47 MHz'
    value: -separacion * 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1616
    - 1296
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: Frecuencia de la portadora
    value: linea - f_tono
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2016
    - 1296
    rotation: 0
    state: enabled
- name: emite
  id: variable
  parameters:
    comment: 1 cuando el tono esta encendido
    value: 1 if (pausa == 0 and paso >= 0 and (fijo >= 0 or congelar == 1 or en_corte
      == 0)) else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2416
    - 1296
    rotation: 0
    state: enabled
- name: medidos
  id: variable
  parameters:
    comment: 'Lo que entrega la placa en cada linea con la

      amplitud base y la ganancia de lectura, en

      dBm. 0 es sin dato. Lo cargan los botones'
    value: '[0.0] * n_lineas'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1516
    rotation: 0
    state: enabled
- name: pedido
  id: variable
  parameters:
    comment: 'Cuanto hay que subir (o bajar) la amplitud de

      cada linea, en dB, para llegar a su objetivo.

      Sin dato, sale con la amplitud base'
    value: '[((objetivo[k] - (medidos[k] + ganancia - ganancia_de_lectura)) if medidos[k]
      != 0 else 0.0) for k in range(n_lineas)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 416
    - 1516
    rotation: 0
    state: enabled
- name: amp_tabla
  id: variable
  parameters:
    comment: 'Amplitud del tono para cada linea, con tope

      en amp_max'
    value: '[min(amp_base * 10 ** (db / 20.0), amp_max) for db in pedido]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 816
    - 1516
    rotation: 0
    state: enabled
- name: sin_margen
  id: variable
  parameters:
    comment: Lineas que piden mas amplitud de la que hay
    value: sum(1 for db in pedido if amp_base * 10 ** (db / 20.0) > amp_max)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1216
    - 1516
    rotation: 0
    state: enabled
- name: cargadas
  id: variable
  parameters:
    comment: Lineas que ya tienen un valor cargado
    value: sum(1 for leido in medidos if leido != 0)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1616
    - 1516
    rotation: 0
    state: enabled
- name: ganancia_minima
  id: variable
  parameters:
    comment: 'La menor ganancia con la que ninguna linea

      pide mas de amp_max. Con la base de 0,25 y el

      tope de 0,95 se puede subir hasta 11,6 dB'
    value: int(math.ceil(ganancia_de_lectura + max([objetivo[k] - medidos[k] for k
      in range(n_lineas) if medidos[k] != 0]) - 20 * math.log10(amp_max / amp_base)))
      if cargadas > 0 else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2016
    - 1516
    rotation: 0
    state: enabled
- name: nivel_sin_calibrar
  id: variable
  parameters:
    comment: 'Nivel aproximado de una linea sin calibrar,

      en dBm, segun la ganancia elegida'
    value: ganancia - 68
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2416
    - 1516
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: 'Ganancia que recibe la placa: en pausa baja

      al minimo'
    value: ganancia if pausa == 0 else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1736
    rotation: 0
    state: enabled
- name: amp_tx
  id: variable
  parameters:
    comment: Amplitud del tono de esta linea
    value: amp_tabla[indice] if emite == 1 else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 416
    - 1736
    rotation: 0
    state: enabled
- name: nivel_estimado
  id: variable
  parameters:
    comment: 'Lo que deberia salir por cable en cada linea

      con la ganancia y la amplitud actuales'
    value: '[((medidos[k] + ganancia - ganancia_de_lectura) + 20 * math.log10(amp_tabla[k]
      / amp_base)) if medidos[k] != 0 else -100 for k in range(n_lineas)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 816
    - 1736
    rotation: 0
    state: enabled
- name: etapa
  id: variable
  parameters:
    comment: Texto de la etapa actual
    value: '''PAUSA (sin emitir)'' if pausa == 1 else (''INICIACION'' if paso < 0
      else (''LINEA FIJA, emision continua'' if fijo >= 0 else (''LINEA CONGELADA,
      emision continua'' if congelar == 1 else (''CORTE (salto de linea)'' if en_corte
      == 1 else ''EMITIENDO''))))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1216
    - 1736
    rotation: 0
    state: enabled
- name: limite_lineas
  id: variable
  parameters:
    comment: 'CISPR 11 grupo 1 clase A a 3 m: 50 dBuV/m

      hasta 230 MHz y 57 arriba'
    value: '[(50.0 if f_primera / 1e6 + 10 * k <= 230 else 57.0) for k in range(n_lineas)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1616
    - 1736
    rotation: 0
    state: enabled
- name: et_etapa
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt; color:" + (''#c0392b'' if
      ''PAUSA'' in str(x) else (''#d68910'' if ''CORTE'' in str(x) else (''#2e86c1''
      if ''LINEA'' in str(x) else (''#1e8449'' if ''EMITIENDO'' in str(x) else ''gray''))))
      + "''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,0,1,4
    label: '<span style=''font-size:15pt''>Etapa: </span>'
    type: string
    value: etapa
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1956
    rotation: 0
    state: enabled
- name: et_linea
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt; color:" + (''black'') + "''><b>"
      + str(x) + "</b></span>"'
    gui_hint: 0,4,1,4
    label: '<span style=''font-size:15pt''>Linea: </span>'
    type: string
    value: ('%.0f MHz (fija)' % (linea / 1e6)) if fijo >= 0 else '%.0f MHz (%d de
      %d, pasada %d)' % (linea / 1e6, posicion + 1, n_lineas, pasada)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 416
    - 1956
    rotation: 0
    state: enabled
- name: et_portadora
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt; color:" + (''black'') + "''><b>"
