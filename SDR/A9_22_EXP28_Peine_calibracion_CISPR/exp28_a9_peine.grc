    type: string
    value: '''%d min %02d s (%.1f s encendida y %.1f s apagada por linea)'' % (n_lineas
      * por_linea // 600, (n_lineas * por_linea // 10) % 60, encendido / 10.0, apagado
      / 10.0)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
