    rotation: 0
    state: enabled
- name: et_espurias
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt; color:" + (''black'') + "''><b>"
      + str(x) + "</b></span>"'
    gui_hint: 4,6,1,6
    label: '<span style=''font-size:11pt''>Sus espurias (MHz): </span>'
    type: string
    value: '''fuga %.2f, imagen %.2f, 3C+S %.2f, 5C-S %.2f'' % (freq / 1e6, freq /
      1e6 + separacion, 3 * freq / 1e6 + separacion, 5 * freq / 1e6 - separacion)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2016
    - 1956
    rotation: 0
    state: enabled
- name: et_cargadas
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt; color:" + (''#c0392b'' if
      ''NO coincide'' in str(x) else ''black'') + "''><b>" + str(x) + "</b></span>"'
    gui_hint: 5,0,1,3
    label: '<span style=''font-size:11pt''>Conducida: </span>'
    type: string
    value: '(''%d/%d'' % (cargadas, n_lineas)) + (('', es de %g MHz: NO coincide''
      % separacion_cal) if (cargadas > 0 and separacion_cal != 0 and separacion_cal
      != separacion) else (('', de %g MHz'' % separacion_cal) if separacion_cal !=
      0 else ''''))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 2136
    rotation: 0
    state: enabled
- name: et_margen
  id: variable_qtgui_label
  parameters:
