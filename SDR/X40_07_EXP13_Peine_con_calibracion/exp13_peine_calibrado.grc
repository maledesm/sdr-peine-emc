- name: calibracion
  id: snippet
  parameters:
    alias: ''
    comment: Calibra la placa con bladeRF-cli antes de abrirla
    code: "# Corre ANTES de que el osmocom Sink abra la placa, cuando todavia esta\
      \ libre.\nimport os, shutil, subprocess, time\n\ncli = r\"C:\\Program Files\\\
      bladeRF\\x64\\bladeRF-cli.exe\"\ncarpeta = os.path.dirname(os.path.abspath(__file__))\n\
      destino = os.path.join(os.environ[\"APPDATA\"], \"Nuand\", \"bladeRF\")   #\
      \ donde la biblioteca busca las tablas\n\ndef correr(comandos):\n    \"\"\"\
      Ejecuta comandos de bladeRF-cli, muestra la salida en la consola y la devuelve.\"\
      \"\"\n    args = [cli]\n    for c in comandos:\n        args += [\"-e\", c]\n\
      \    p = subprocess.Popen(args, cwd=carpeta, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\
      \ text=True)\n    salida = []\n    for linea in p.stdout:\n        print(\"\
      \   [bladeRF-cli] \" + linea.rstrip())\n        salida.append(linea)\n    p.wait()\n\
      \    return \"\".join(salida)\n\ndef tablas(sufijo):\n    return [f for f in\
      \ os.listdir(destino) if f.endswith(\"_dc_tx\" + sufijo)] if os.path.isdir(destino)\
      \ else []\n\nprint(\"=== EXP-13: calibracion antes de transmitir ===\")\nt_inicio\
      \ = time.time()\n\nif self.calibrar_lms:\n    print(\"1) calibrate lms\")\n\
      \    correr([\"calibrate lms\"])\n    print(\"   Lectura en una apertura nueva\
      \ (si no son todos 31, la calibracion sobrevive al cierre):\")\n    correr([\"\
      calibrate lms show\"])\n\nif self.generar_tabla:\n    print(\"2) Generando la\
      \ tabla de fuga para las portadoras del peine. Puede tardar varios minutos.\"\
      )\n    for f in os.listdir(carpeta):          # borrar tablas de corridas anteriores\n\
      \        if f.endswith(\"_dc_tx.tbl\"):\n            os.remove(os.path.join(carpeta,\
      \ f))\n    f_min = \"%dM\" % round(min(self.portadoras) / 1e6)\n    f_max =\
      \ \"%dM\" % round(max(self.portadoras) / 1e6)\n    salida = correr([\"set gain\
      \ tx1 %d\" % self.ganancia_tabla,\n                     \"print gain\",\n  \
      \                   \"calibrate table dc tx %s %s 20M\" % (f_min, f_max)])\n\
      \    nuevas = [f for f in os.listdir(carpeta) if f.endswith(\"_dc_tx.tbl\")]\n\
      \    if nuevas:\n        os.makedirs(destino, exist_ok=True)\n        for f\
      \ in nuevas:\n            shutil.copyfile(os.path.join(carpeta, f), os.path.join(destino,\
      \ f))\n            print(\"   Tabla instalada: \" + os.path.join(destino, f))\n\
      \    else:\n        print(\"   ATENCION: no se genero ninguna tabla. Revisar\
      \ los mensajes de arriba.\")\n\n# activar o desactivar la tabla instalada, para\
      \ comparar con y sin correccion\nif self.usar_tabla:\n    for f in tablas(\"\
      .tbl.desactivada\"):\n        os.replace(os.path.join(destino, f), os.path.join(destino,\
      \ f[:-len(\".desactivada\")]))\n    print(\"3) Tabla de fuga ACTIVADA: \" +\
      \ (\", \".join(tablas(\".tbl\")) or \"no hay ninguna instalada\"))\nelse:\n\
      \    for f in tablas(\".tbl\"):\n        os.replace(os.path.join(destino, f),\
      \ os.path.join(destino, f + \".desactivada\"))\n    print(\"3) Tabla de fuga\
      \ DESACTIVADA: la placa transmite sin correccion\")\nprint(\"=== Fin de la calibracion\
      \ ===\")\n\n# aviso sonoro y cartel: la transmision empieza recien al aceptar\n\
      lineas = [\"Calibracion terminada en %.0f segundos.\" % (time.time() - t_inicio),\
      \ \"\",\n          \"calibrate lms: \" + (\"ejecutada\" if self.calibrar_lms\
      \ else \"omitida\"),\n          \"Tabla de fuga: \" + (\"generada\" if self.generar_tabla\
      \ else \"no regenerada\"),\n          \"Estado de la tabla: \" + ((\"ACTIVADA\
      \ (%s)\" % (\", \".join(tablas(\".tbl\")) or \"no hay ninguna instalada\"))\n\
      \                                    if self.usar_tabla else \"DESACTIVADA\"\
      ), \"\",\n          \"Al aceptar se abre la placa y empieza a transmitir.\"\
      ]\nresumen = chr(10).join(lineas)\ntry:\n    import winsound\n    for _ in range(3):\n\
      \        winsound.Beep(1000, 250)\nexcept Exception:\n    pass\ntry:\n    Qt.QMessageBox.information(None,\
      \ \"EXP-13: calibracion terminada\", resumen)\nexcept Exception as e:\n    print(\"\
      No se pudo mostrar el cartel: %s\" % e)\nprint(\"=== Abriendo la placa para\
      \ transmitir ===\")\n"
