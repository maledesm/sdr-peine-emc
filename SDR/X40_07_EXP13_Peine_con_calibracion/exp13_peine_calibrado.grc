    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 780
    rotation: 0
    state: enabled
- name: indice
  id: variable
  parameters:
    comment: Numero de portadora, desde 0
    value: min(max(int(round(indice_medido)), 0), len(portadoras) - 1)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 780
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: Frecuencia del oscilador
    value: portadora_manual if modo == 1 else portadoras[indice]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 736
    - 780
    rotation: 0
    state: enabled
- name: c_inf
  id: variable
  parameters:
    comment: Fase aplicada al tono inferior
    value: np.exp(1j*np.deg2rad(fase_inf))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 780
    rotation: 0
    state: enabled
