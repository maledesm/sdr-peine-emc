options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Igual al EXP-12, mas un Python Snippet que antes de abrir la placa
      llama a bladeRF-cli: calibrate lms y tabla de correccion de la fuga de portadora
      por frecuencia'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: exp13_peine_calibrado
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: EXP-13 peine de 8 tonos con calibracion de la placa
    window_size: (1900,1700)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import numpy as np
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 16
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Tasa de muestreo. Requiere USB 3
    value: 20e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 16
    rotation: 0
    state: enabled
- name: f_tono
  id: variable
  parameters:
    comment: Los dos tonos van en +f_tono y -f_tono
    value: 5e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 16
    rotation: 0
    state: enabled
- name: tasa_ctrl
  id: variable
  parameters:
    comment: Tasa de la rama de control del barrido
    value: 10e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 16
    rotation: 0
    state: enabled
- name: portadoras
  id: variable
  parameters:
    comment: 4 portadoras, de 305 a 365 MHz
    value: '[305e6 + 20e6*i for i in range(4)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 16
    rotation: 0
    state: enabled
- name: modo
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 0,0,1,1
    label: Modo
    labels: '[]'
    options: '[0, 1, 2]'
    num_opts: '2'
    orient: Qt.QHBoxLayout
    type: real
    value: '0'
    widget: radio_buttons
    option0: '0'
    label0: Automatico
    option1: '1'
    label1: Manual
    option2: '2'
    label2: ''
    option3: '3'
    label3: ''
    option4: '4'
    label4: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 180
    rotation: 0
    state: enabled
- name: portadora_manual
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 0,1,1,1
    label: Portadora en modo manual
    labels: '[''305 MHz'', ''325 MHz'', ''345 MHz'', ''365 MHz'']'
    options: '[305000000, 325000000, 345000000, 365000000]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: real
    value: '305000000'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 180
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 0,2,1,1
    label: Ganancia TX (dB)
    labels: '[]'
    options: '[0, 1, 2]'
    num_opts: '4'
    orient: Qt.QHBoxLayout
    type: real
    value: '30'
    widget: radio_buttons
    option0: '17'
    label0: '17'
    option1: '20'
    label1: '20'
    option2: '25'
    label2: '25'
    option3: '30'
    label3: '30'
    option4: '4'
    label4: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 180
    rotation: 0
    state: enabled
- name: permanencia
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,1
    label: Permanencia por portadora (s)
    min_len: '250'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '1'
    step: '0.5'
    stop: '20'
    value: '2'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 420
    rotation: 0
    state: enabled
- name: amp
  id: variable_qtgui_range
  parameters:
