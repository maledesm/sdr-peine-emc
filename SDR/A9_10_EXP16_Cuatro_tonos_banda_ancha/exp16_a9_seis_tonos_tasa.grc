options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'bladeRF 2.0 micro xA9: seis tonos en +/-5, +/-10 y +/-20 MHz con
      habilitacion y amplitud propias, y selector de tasa de muestreo para encontrar
      la maxima sin cortes'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: exp16_a9_seis_tonos_tasa
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'EXP-16 xA9: seis tonos y tasa de muestreo'
    window_size: (2500,1900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: suma_max
  id: variable
  parameters:
    comment: La suma de amplitudes nunca pasa de este valor (evita el desborde)
    value: '0.95'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 16
    rotation: 0
    state: enabled
- name: fraccion_util
  id: variable
  parameters:
    comment: Un tono entra si su frecuencia no supera esta fraccion de la tasa de
      muestreo
    value: '0.4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 16
    rotation: 0
    state: enabled
- name: ancho_banda
  id: variable
  parameters:
    comment: Filtro analogico de la placa, segun la tasa
    value: min(0.9 * samp_rate, 56e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1106
    - 16
    rotation: 0
    state: enabled
- name: freq
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 0,0,1,6
    label: Portadora
    labels: '[''100 MHz'', ''500 MHz'', ''1 GHz'', ''1,5 GHz'', ''2 GHz'', ''3 GHz'',
      ''4 GHz'', ''5 GHz'']'
    options: '[100000000, 500000000, 1000000000, 1500000000, 2000000000, 3000000000,
      4000000000, 5000000000]'
    num_opts: '0'
    orient: Qt.QHBoxLayout
    type: real
    value: '100000000'
    widget: radio_buttons
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 180
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,0,1,6
    label: Ganancia de transmision (dB)
    labels: '[''0 dB'', ''15 dB'', ''30 dB'', ''45 dB'', ''55 dB'', ''60 dB'']'
    options: '[0, 15, 30, 45, 55, 60]'
    num_opts: '0'
    orient: Qt.QHBoxLayout
    type: real
    value: '0'
    widget: radio_buttons
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
