- name: suma
  id: variable
  parameters:
    comment: Suma de las amplitudes activas
    value: act_m20*amp_m20 + act_m10*amp_m10 + act_m5*amp_m5 + act_p5*amp_p5 + act_p10*amp_p10
      + act_p20*amp_p20
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1570
    rotation: 0
    state: enabled
- name: escala
  id: variable
  parameters:
    comment: Factor comun que evita el desborde
    value: min(1.0, suma_max / suma) if suma > 0 else 1.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 1570
    rotation: 0
    state: enabled
- name: aspecto
  id: snippet
  parameters:
    alias: ''
    comment: Letra grande, y controles en gris cuando un tono no entra en la tasa
    priority: '0'
    section: main_after_init
    code: "# Ajustes de aspecto que los bloques de GNU Radio no permiten configurar.\n\
      # 1) Etiquetas de estado con letra grande.\nfor nombre in ('et_suma', 'et_escala'):\n\
      \    barra = getattr(self, '_%s_tool_bar' % nombre)\n    ancho = 120\n    for\
      \ accion in barra.actions():\n        etiqueta = barra.widgetForAction(accion)\n\
      \        etiqueta.setStyleSheet('font-size: 15pt; font-weight: bold')\n    \
      \    ancho += etiqueta.sizeHint().width()\n    barra.setMinimumWidth(ancho)\n\
      \n# 2) Si un tono no entra en la tasa elegida, su casilla y su amplitud quedan\
      \ en gris y no se pueden tocar.\n#    (El flujo igual lo deja apagado por su\
      \ cuenta: esto es solo para que se vea.)\ntonos = ('m20', 'm10', 'm5', 'p5',\
      \ 'p10', 'p20')\ndef actualizar_disponibles():\n    for columna, t in enumerate(tonos):\n\
      \        entra = bool(getattr(self, 'cabe_' + t))\n        self.top_grid_layout.itemAtPosition(5,\
      \ columna).widget().setEnabled(entra)   # casilla de habilitar\n        getattr(self,\
      \ '_amp_%s_group_box' % t).setEnabled(entra)                     # botones de\
      \ amplitud\ncambiar_tasa = self.set_samp_rate\ndef cambiar_tasa_y_actualizar(valor):\n\
      \    cambiar_tasa(valor)\n    actualizar_disponibles()\nself.set_samp_rate =\
      \ cambiar_tasa_y_actualizar\nactualizar_disponibles()\n\n# 3) Tamano inicial\
      \ de la ventana segun su contenido.\nself.resize(self.top_widget.minimumSizeHint().width()\
      \ + 60, self.top_widget.minimumSizeHint().height() + 70)\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1996
    - 1570
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import numpy as np
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 16
    rotation: 0
    state: enabled
- name: n_tabla
  id: variable
  parameters:
    comment: 'Indices de la tabla: 1000 periodos de 5 MHz'
    value: np.arange(int(round(samp_rate / 5e6)) * 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1620
    rotation: 0
    state: enabled
- name: tabla
  id: variable
  parameters:
    comment: Suma de los seis tonos, lista para repetir
    value: (k_m20*np.exp(2j*np.pi*(-20000000)*n_tabla/samp_rate) + k_m10*np.exp(2j*np.pi*(-10000000)*n_tabla/samp_rate)
      + k_m5*np.exp(2j*np.pi*(-5000000)*n_tabla/samp_rate) + k_p5*np.exp(2j*np.pi*(5000000)*n_tabla/samp_rate)
      + k_p10*np.exp(2j*np.pi*(10000000)*n_tabla/samp_rate) + k_p20*np.exp(2j*np.pi*(20000000)*n_tabla/samp_rate)
      + 0j*n_tabla).tolist()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 1620
    rotation: 0
    state: enabled
