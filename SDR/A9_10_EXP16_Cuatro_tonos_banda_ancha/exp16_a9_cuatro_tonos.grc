options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'bladeRF 2.0 micro xA9 a 50 MSPS: cuatro tonos en +/-10 y +/-20 MHz,
      cada uno con habilitacion, amplitud y fase propias. Para superponer un tono
      a la imagen de otro'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: exp16_a9_cuatro_tonos
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'EXP-16 xA9: cuatro tonos en banda ancha'
    window_size: (2100,1900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import numpy as np
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 16
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'Tasa de muestreo: hace falta para llegar a +/-20 MHz. Requiere USB 3'
    value: 50e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 16
    rotation: 0
    state: enabled
- name: ancho_banda
  id: variable
  parameters:
    comment: Filtro analogico de la placa
    value: 50e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 16
    rotation: 0
    state: enabled
- name: suma_max
  id: variable
  parameters:
    comment: La suma de amplitudes nunca pasa de este valor (evita el desborde)
    value: '0.95'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 16
    rotation: 0
    state: enabled
- name: freq
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 0,0,1,4
    label: Portadora
    labels: '[''100 MHz'', ''500 MHz'', ''1 GHz'', ''1,5 GHz'', ''2 GHz'', ''3 GHz'',
      ''4 GHz'', ''5 GHz'']'
    options: '[100000000, 500000000, 1000000000, 1500000000, 2000000000, 3000000000,
      4000000000, 5000000000]'
    num_opts: '0'
    orient: Qt.QHBoxLayout
    type: real
    value: '100000000'
    widget: radio_buttons
