    - 1170
    rotation: 0
    state: enabled
- name: suma
  id: variable
  parameters:
    comment: Suma de las amplitudes habilitadas
    value: hab_m20*amp_m20 + hab_m10*amp_m10 + hab_p10*amp_p10 + hab_p20*amp_p20
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1220
    rotation: 0
    state: enabled
- name: escala
  id: variable
  parameters:
    comment: Factor comun que evita el desborde
    value: min(1.0, suma_max / suma) if suma > 0 else 1.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 1220
    rotation: 0
    state: enabled
- name: aspecto
  id: snippet
  parameters:
    alias: ''
    comment: Letra grande en las etiquetas de estado
    priority: '0'
    section: main_after_init
    code: "# Las etiquetas de GNU Radio no tienen tamano de letra: se lo cambiamos\
      \ aca.\nfor nombre in ('et_suma', 'et_escala'):\n    barra = getattr(self, '_%s_tool_bar'\
      \ % nombre)\n    ancho = 120\n    for accion in barra.actions():\n        etiqueta\
      \ = barra.widgetForAction(accion)\n        etiqueta.setStyleSheet('font-size:\
      \ 15pt; font-weight: bold')\n        ancho += etiqueta.sizeHint().width()\n\
      \    barra.setMinimumWidth(ancho)\n# Los deslizadores verticales de fase necesitan\
      \ altura para moverlos con precision.\nfor tono in ('m20', 'm10', 'p10', 'p20'):\n\
      \    getattr(self, '_fase_%s_win' % tono).setMinimumHeight(200)\nself.resize(self.top_widget.minimumSizeHint().width()\
      \ + 60,\n            self.top_widget.minimumSizeHint().height() + 70)\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 1220
    rotation: 0
    state: enabled
- name: k_m20
  id: variable
  parameters:
    comment: Amplitud y fase del tono de -20 MHz
    value: hab_m20 * amp_m20 * escala * np.exp(1j*np.deg2rad(fase_m20))
  states:
    bus_sink: false
    bus_source: false
