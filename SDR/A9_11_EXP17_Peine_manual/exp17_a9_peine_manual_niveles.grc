options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'bladeRF 2.0 micro xA9: peine de 70 a 420 MHz, lineas cada 10 MHz.
      Igual al EXP-17, pero la ganancia se elige por el nivel de cada linea: -33,
      -20, -10, -5 o 0 dBm. SOLO para medir con el analizador: nunca con el cable
      en RX1. Sin codigo Python'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: exp17_a9_peine_manual_niveles
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'EXP-17 xA9: peine manual con selector de nivel'
    window_size: (2800,2760)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'Tasa de muestreo. En esta PC no pasar de

      25e6'
    value: 20e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 16
    rotation: 0
    state: enabled
- name: f_tono
  id: variable
  parameters:
    comment: 'Cada portadora lleva dos tonos: en +f_tono y

      en -f_tono'
    value: 5e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 16
    rotation: 0
    state: enabled
- name: amp
  id: variable
  parameters:
    comment: 'Amplitud de cada tono. La suma de los dos no

      debe pasar de 0.95'
    value: '0.45'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 16
    rotation: 0
    state: enabled
- name: ancho_banda
  id: variable
  parameters:
    comment: Filtro analogico de la placa
    value: 18e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 16
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 16
    rotation: 0
    state: enabled
- name: f_primera
  id: variable
  parameters:
    comment: 'Primera portadora. Sus lineas salen en 70 y

      80 MHz'
    value: 75e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 200
    rotation: 0
    state: enabled
- name: paso_port
  id: variable
  parameters:
    comment: Separacion entre portadoras
    value: 20e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 200
    rotation: 0
    state: enabled
- name: n_port
  id: variable
  parameters:
    comment: 'Cantidad de portadoras: 18 dan 36 lineas, de

      70 a 420 MHz'
    value: '18'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 200
    rotation: 0
    state: enabled
- name: permanencia
  id: variable
  parameters:
    comment: 'Segundos en cada portadora. Tiene que ser

      mayor que un barrido del analizador'
    value: '2.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 200
    rotation: 0
    state: enabled
- name: lista_de_pasos
  id: variable
  parameters:
    comment: 'Los pasos del barrido: 0, 1, 2, ...'
    value: list(range(100000))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 400
    rotation: 0
    state: enabled
- name: paso
  id: variable_function_probe
  parameters:
    block_id: lista_de_pasos
    comment: 'Cada ''permanencia'' segundos saca el primer

      numero de la lista: es el paso actual'
    function_args: '0'
    function_name: pop
    poll_rate: 1.0 / permanencia
    value: '-1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 400
    rotation: 0
    state: enabled
- name: indice
  id: variable
  parameters:
    comment: Portadora actual, de 0 a n_port - 1
    value: max(paso, 0) % n_port
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 736
    - 400
    rotation: 0
    state: enabled
- name: pasada
  id: variable
  parameters:
    comment: Cuantas veces se recorrio el peine
    value: max(paso, 0) // n_port + 1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1066
    - 400
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: Frecuencia de la portadora actual
    value: f_primera + paso_port * indice
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1456
    - 400
    rotation: 0
    state: enabled
- name: emitir
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    gui_hint: 2,0,1,3
    label: Emitir (destildar para dejar la salida en silencio)
    type: int
    'true': '1'
    'false': '0'
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 620
    rotation: 0
    state: enabled
- name: ganancia_base
  id: variable_qtgui_chooser
  parameters:
    comment: 'Cada opcion es una ganancia de transmision;

      el nivel es el medido con la tinySA'
    gui_hint: 2,3,1,3
    label: Nivel por linea
    labels: '[''-33 dBm (ganancia 30)'', ''-20 dBm (ganancia 43)'', ''-10 dBm (ganancia
      53)'', ''-5 dBm (ganancia 58)'', ''0 dBm (ganancia 63)'']'
    options: '[30, 43, 53, 58, 63]'
    num_opts: '0'
    orient: Qt.QVBoxLayout
    type: int
    value: '30'
    widget: combo_box
    option0: '0'
    label0: '0'
    option1: '1'
    label1: '1'
    option2: '2'
    label2: '2'
    option3: '3'
    label3: '3'
    option4: '4'
    label4: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 620
    rotation: 0
    state: enabled
- name: tabla_inicial
  id: variable
  parameters:
    comment: 'Correcciones con las que arranca el flujo,

      una por portadora. Para guardar una

      calibracion, copiar aca la ''Tabla actual'' de

      la ventana'
    value: '[0] * 18'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 620
    rotation: 0
    state: enabled
- name: tabla
  id: variable
  parameters:
    comment: 'Correccion elegida para cada portadora, en

      dB'
    value: '[c_75, c_95, c_115, c_135, c_155, c_175, c_195, c_215, c_235, c_255, c_275,
      c_295, c_315, c_335, c_355, c_375, c_395, c_415]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 620
    rotation: 0
    state: enabled
- name: niveles_altos
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    gui_hint: 3,0,1,9
    label: Permitir -5 y 0 dBm por linea. Tildar SOLO con la atenuacion del analizador
      fija en 30 dB
    type: int
    'true': '1'
    'false': '0'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1468
    - 620
    rotation: 0
    state: enabled
- name: correccion
  id: variable
  parameters:
    comment: Correccion de la portadora actual, en dB
    value: tabla[indice]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 880
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: 'Ganancia que recibe la placa. Cambia junto

      con la frecuencia en cada salto'
    value: min(ganancia_base + correccion, tope)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 880
    rotation: 0
    state: enabled
- name: amp_tx
  id: variable
  parameters:
    comment: Amplitud de los dos tonos (0 en silencio)
    value: amp if emitir == 1 else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 776
    - 880
    rotation: 0
    state: enabled
- name: nivel_estimado
  id: variable
  parameters:
    comment: 'dBm por linea, segun lo medido el

      04-10-2026: -33 dBm con ganancia 30'
    value: tx_gain - 56 + 20 * math.log10(amp)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1106
    - 880
    rotation: 0
    state: enabled
- name: etapa
  id: variable
  parameters:
    comment: Texto de la etapa actual
    value: '''SILENCIO'' if emitir == 0 else (''INICIACION'' if paso < 0 else ''TRANSMISION,
      pasada %d'' % pasada)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 880
    rotation: 0
    state: enabled
- name: tope
  id: variable
  parameters:
    comment: 'Tope de seguridad de la ganancia: 53 (-10

      dBm por linea) salvo que se tilde la casilla

      de niveles altos'
    value: 63 if niveles_altos == 1 else 53
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2062
    - 880
    rotation: 0
    state: enabled
- name: et_etapa
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,0,1,3
    label: '<span style=''font-size:15pt''>Etapa: </span>'
    type: string
    value: etapa
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1080
    rotation: 0
    state: enabled
- name: et_portadora
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,3,1,3
    label: '<span style=''font-size:15pt''>Portadora: </span>'
    type: string
    value: '''%d de %d, en %.0f MHz'' % (indice + 1, n_port, freq / 1e6)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 346
    - 1080
    rotation: 0
    state: enabled
- name: et_lineas
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:15pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 0,6,1,3
    label: '<span style=''font-size:15pt''>Lineas: </span>'
    type: string
    value: '''%.0f y %.0f MHz'' % ((freq - f_tono) / 1e6, (freq + f_tono) / 1e6)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 676
    - 1080
    rotation: 0
    state: enabled
- name: et_ganancia
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 1,0,1,5
    label: '<span style=''font-size:11pt''>Ganancia aplicada: </span>'
    type: string
    value: '(''%d dB'' % tx_gain) + ('' (LIMITADA por el tope: falta tildar la casilla)''
      if ganancia_base + correccion > tope else '''')'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1006
    - 1080
    rotation: 0
    state: enabled
- name: et_nivel
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 1,5,1,4
    label: '<span style=''font-size:11pt''>Nivel por linea: </span>'
    type: string
    value: ('unos %.0f dBm' % nivel_estimado) if emitir == 1 else 'sin emision'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 1080
    rotation: 0
    state: enabled
- name: et_tiempos
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: "<span style=''font-size:11pt''><b>" + str(x) + "</b></span>"'
    gui_hint: 2,6,1,3
    label: '<span style=''font-size:11pt''>Pasada completa: </span>'
    type: string
    value: '''%.0f s (%.1f s por portadora)'' % (permanencia * n_port, permanencia)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1666
    - 1080
    rotation: 0
    state: enabled
- name: et_titulo
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 4,0,1,9
    label: <span style='font-size:11pt'><b>Correccion por portadora, en dB.</b> Cada
      selector baja las dos lineas de su portadora</span>
    type: string
    value: ''''''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1996
    - 1080
    rotation: 0
    state: enabled
- name: et_tabla
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 8,0,1,9
    label: 'Tabla actual (para copiar en tabla_inicial): '
    type: string
    value: str(tabla)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2326
    - 1080
    rotation: 0
    state: enabled
- name: tono_superior
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: Sale en portadora + 5 MHz
    maxoutbuf: '0'
    minoutbuf: '0'
    amp: amp_tx
    freq: f_tono
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1300
    rotation: 0
    state: enabled
- name: tono_inferior
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: Sale en portadora - 5 MHz
    maxoutbuf: '0'
    minoutbuf: '0'
    amp: amp_tx
    freq: -f_tono
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1500
    rotation: 0
    state: enabled
- name: suma
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 511
    - 1410
    rotation: 0
    state: enabled
