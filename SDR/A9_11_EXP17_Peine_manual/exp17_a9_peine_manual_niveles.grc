- name: linea_de_punto
  id: variable
  parameters:
    comment: 'El grafico tiene 256 puntos, 7 por linea: a

      que linea (0 a 35) corresponde cada punto'
    value: '[min(j // 7, 2 * n_port - 1) for j in range(256)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1720
    rotation: 0
    state: enabled
- name: curva_tabla
  id: variable
  parameters:
    comment: Correccion de cada linea, punto por punto
    value: '[tabla[k // 2] for k in linea_de_punto]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1850
    rotation: 0
    state: enabled
- name: curva_actual
  id: variable
  parameters:
    comment: Marca las dos lineas que salen ahora
    value: '[(tabla[k // 2] if (k // 2 == indice and emitir == 1) else -13) for k
      in linea_de_punto]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1980
    rotation: 0
    state: enabled
